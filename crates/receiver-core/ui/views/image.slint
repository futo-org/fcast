import { Bridge } from "../globals.slint";

component Animation inherits Rectangle {
    Image {
        source: Bridge.animation-frames[Bridge.current-animation-frame].img;
        image-fit: contain;
        width: 100%;
        height: 100%;
    }

    Timer {
        interval: Bridge.animation-frames[Bridge.current-animation-frame].delay;

        triggered => {
            Bridge.current-animation-frame = Math.mod(Bridge.current-animation-frame + 1, Bridge.animation-frames.length);
        }
    }
}

export component ImageView inherits Rectangle {
    width: 100%;
    height: 100%;
    // Animated images decoded by the player pipeline (image-via-player) render
    // into the video sink below, so this view stays fully transparent and paints
    // nothing. The legacy path (still jpeg/png images and thumbnails) keeps the
    // black backdrop and paints the decoded image / frames here.
    background: Bridge.image-via-player ? transparent : black;

    if !Bridge.image-via-player && Bridge.image-preview.img.width > 0: Image {
        source: Bridge.image-preview.img;
        image-fit: contain;
        width: 100%;
        height: 100%;
        transform-rotation: Bridge.image-preview.rotation;
    }

    if !Bridge.image-via-player && Bridge.animation-frames.length > 0: Animation { }
}
