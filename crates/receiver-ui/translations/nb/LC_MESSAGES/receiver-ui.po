#: crates/receiver-core/ui/views/idle.slint:91
msgctxt "IdleView"
msgid "Idle. Ready to cast"
msgstr "Klar til å caste"

#: crates/receiver-core/ui/views/idle.slint:100
msgctxt "IdleView"
msgid ""
"Stream to this device by opening your FCast sender app and selecting this "
"device from the Cast menu, or scan the QR code for instant setup."
msgstr "Strøm til denne enheten ved å åpne en FCast sender applikasjon og "
"velg denne enheten fra Cast menyen, eller scan QR koden for umiddelbar "
"tilkobling."

#: crates/receiver-core/ui/views/idle.slint:120
msgctxt "IdleView"
msgid "Device name"
msgstr "Enhetsnavn"

#: crates/receiver-core/ui/views/idle.slint:133
msgctxt "IdleView"
msgid "Local IP Address"
msgstr "Lokal IP adresse"

#: crates/receiver-core/ui/views/idle.slint:141
msgctxt "IdleView"
msgid "An update is available. Do you want to update now?"
msgstr "En oppdatering er tilgjengelig. Ønsker du å oppdatere nå?"

#: crates/receiver-core/ui/views/idle.slint:149
#: crates/receiver-core/ui/views/idle.slint:149
msgctxt "IdleView"
msgid "Yes"
msgstr "Ja"

#: crates/receiver-core/ui/views/idle.slint:155
#: crates/receiver-core/ui/views/idle.slint:155
msgctxt "IdleView"
msgid "No"
msgstr "Nei"

#: crates/receiver-core/ui/views/idle.slint:166
msgctxt "IdleView"
msgid "Downloading update..."
msgstr "Laster ned oppdatering..."

#: crates/receiver-core/ui/views/idle.slint:177
msgctxt "IdleView"
msgid "Failed to download update: {}"
msgstr "Klarte ikke å laste ned oppdatering: {}"

#: crates/receiver-core/ui/views/idle.slint:183
msgctxt "IdleView"
msgid "Failed to install update: {}"
msgstr "Klarte ikke å installere oppdatering: {}"

#: crates/receiver-core/ui/views/idle.slint:189
msgctxt "IdleView"
msgid "Installed update successfully. Do you want to restart the app now?"
msgstr "Oppdatering installert. Ønsker du å restarte applikasjonen nå?"

#: crates/receiver-core/ui/views/idle.slint:248
msgctxt "IdleView"
msgid ""
"Your device isn’t connected to a network. Connect to network via LAN or "
"Wifi to continue."
msgstr "Enheten din er ikke tilkoblet ett nettverk. Koble til ett nettverk "
"via LAN eller WiFi for å fortsette"

#: crates/receiver-core/ui/views/loading-media.slint:14
msgctxt "LoadingMediaView"
msgid "Loading media..."
msgstr "Laster media..."

#: crates/receiver-core/ui/views/video-player.slint:175
msgctxt "SettingsTrackList"
msgid "Off"
msgstr "Av"

#: crates/receiver-core/ui/views/video-player.slint:384
msgctxt "PlaybackControls"
msgid "LIVE"
msgstr "DIREKTE"

#: crates/receiver-core/ui/views/video-player.slint:435
msgctxt "PlaybackControls"
msgid "Playback settings"
msgstr "Avspillingsinnstillinger"

#: crates/receiver-core/ui/views/video-player.slint:445
msgctxt "PlaybackControls"
msgid "Video"
msgstr "Video"

#: crates/receiver-core/ui/views/video-player.slint:454
msgctxt "PlaybackControls"
msgid "Audio"
msgstr "Lyd"

#: crates/receiver-core/ui/views/video-player.slint:463
msgctxt "PlaybackControls"
msgid "Subtitles"
msgstr "Undertekster"

#: crates/receiver-core/ui/views/video-player.slint:472
msgctxt "PlaybackControls"
msgid "Playback Speed"
msgstr "Avspillingshastighet"

#: crates/receiver-core/ui/views/video-player.slint:489
msgctxt "PlaybackControls"
msgid "Video track"
msgstr "Video spor"

#: crates/receiver-core/ui/views/video-player.slint:514
msgctxt "PlaybackControls"
msgid "Audio track"
msgstr "Lyd spor"

#: crates/receiver-core/ui/views/video-player.slint:539
msgctxt "PlaybackControls"
msgid "Subtitle track"
msgstr "Undertekst spor"

#: crates/receiver-core/ui/views/video-player.slint:574
msgctxt "PlaybackControls"
msgid "Playback speed"
msgstr "Avspillingshastighet"

#: crates/receiver-core/ui/main.slint:35
msgctxt "MainWindow"
msgid "FCast Receiver"
msgstr "FCast Mottaker"

#: crates/receiver-ui/ui/toast-overlay.slint
msgctxt "ToastOverlay"
msgid "The media could not be found"
msgstr "Fant ikke mediet"

#: crates/receiver-ui/ui/toast-overlay.slint
msgctxt "ToastOverlay"
msgid "Access to the media was denied"
msgstr "Fikk ikke tilgang til mediet"

#: crates/receiver-ui/ui/toast-overlay.slint
msgctxt "ToastOverlay"
msgid "Network error while streaming"
msgstr "Nettverksfeil under strømming"

#: crates/receiver-ui/ui/toast-overlay.slint
msgctxt "ToastOverlay"
msgid "Network error while streaming from {}"
msgstr "Nettverksfeil under strømming fra {}"

#: crates/receiver-ui/ui/toast-overlay.slint
msgctxt "ToastOverlay"
msgid "The media format is not supported"
msgstr "Medieformatet støttes ikke"

#: crates/receiver-ui/ui/toast-overlay.slint
msgctxt "ToastOverlay"
msgid "A codec needed by the media is missing"
msgstr "Mangler en kodek mediet trenger"

#: crates/receiver-ui/ui/toast-overlay.slint
msgctxt "ToastOverlay"
msgid "The media is damaged and could not be decoded"
msgstr "Mediet er skadet og kunne ikke dekodes"

#: crates/receiver-ui/ui/toast-overlay.slint
msgctxt "ToastOverlay"
msgid "The media is DRM protected and cannot be played"
msgstr "Mediet er DRM-beskyttet og kan ikke spilles av"

#: crates/receiver-ui/ui/toast-overlay.slint
msgctxt "ToastOverlay"
msgid "Audio or video output failed"
msgstr "Lyd- eller videoutgangen feilet"

#: crates/receiver-ui/ui/toast-overlay.slint
msgctxt "ToastOverlay"
msgid "The image could not be downloaded"
msgstr "Kunne ikke laste ned bildet"

#: crates/receiver-ui/ui/toast-overlay.slint
msgctxt "ToastOverlay"
msgid "A track was disabled, its codec is missing"
msgstr "Et spor ble skrudd av, kodeken mangler"

#: crates/receiver-ui/ui/toast-overlay.slint
msgctxt "ToastOverlay"
msgid "No decoder for {}, the track was disabled"
msgstr "Ingen dekoder for {}, sporet ble skrudd av"

#: crates/receiver-ui/ui/toast-overlay.slint
msgctxt "ToastOverlay"
msgid "A stream stopped and will not resume by itself"
msgstr "En strøm stoppet og fortsetter ikke av seg selv"

#: crates/receiver-ui/ui/toast-overlay.slint
msgctxt "ToastOverlay"
msgid "The subtitle format is not supported"
msgstr "Undertekstformatet støttes ikke"

#: crates/receiver-ui/ui/toast-overlay.slint
msgctxt "ToastOverlay"
msgid "A playback problem was detected"
msgstr "Det oppstod et avspillingsproblem"

#: crates/receiver-ui/ui/report-bug.slint
msgctxt "ReportBugPopup"
msgid "Playback failed unexpectedly"
msgstr "Avspillingen feilet uventet"

#: crates/receiver-ui/ui/report-bug.slint
msgctxt "ReportBugPopup"
msgid "This looks like a bug in the receiver. Please report it by scanning the code, and include the details below."
msgstr "Dette ser ut som en feil i mottakeren. Rapporter den gjerne ved å skanne koden, og ta med detaljene under."

#: crates/receiver-ui/ui/report-bug.slint
msgctxt "ReportBugPopup"
msgid "Dismiss"
msgstr "Lukk"
