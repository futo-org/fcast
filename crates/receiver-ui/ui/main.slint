import {
    Icons,
    FText,
    ScrollView,
    Spinner,
    Button,
    Palette,
    ListView,
    Slider,
} from "../../../ui-components/std-widgets.slint";
import { FCastPalette } from "../../../ui-components/styling.slint";
import "../../../ui-components/fonts/Outfit-Regular.ttf";
import {
    Bridge,
    GuiPlaybackState,
    AppState,
    UiPlayerVariant,
    UiUpdaterState,
} from "globals.slint";
import { IdleView } from "views/idle.slint";
import { LoadingMediaView } from "views/loading-media.slint";
import { VideoPlayerView } from "views/video-player.slint";
import { ImageView } from "views/image.slint";
import { AudioPlayerView } from "views/audio-player.slint";
import { RaopView } from "views/raop.slint";
import { ToastOverlay } from "toast-overlay.slint";
import { ReportBugPopup } from "report-bug.slint";
import { StartupView } from "startup.slint";
import { Inspector, InspectorState } from "inspector.slint";
import { SettingsDrawer } from "settings-drawer.slint";

export {
    Bridge,
    GuiPlaybackState,
    AppState,
    UiPlayerVariant,
    InspectorState,
}

export component MainWindow inherits Window {
    title: @tr("FCast Receiver");

    // On android the video surface lives BEHIND this window and a
    // transparent scene region is a real hole onto it. Every non-video
    // scene paints its own full-bleed background, so nothing else leaks.
    // Opaque background pixels in the hole read as a gray screen wherever
    // the compositor blends the window per pixel (Amlogic TV boxes).
    background: Bridge.behind-window-video || Bridge.touch-mode ? transparent : Palette.background;

    default-font-family: "Outfit";
    default-font-size: 15px;
    default-font-weight: 400;

    public function device-connected() {
        Bridge.connected_devices += 1;
    }

    // slint's own inset tracking (fed by the android backend), mirrored
    // into the Bridge for the views
    property <length> sai-left: self.safe-area-insets.left;
    property <length> sai-top: self.safe-area-insets.top;
    property <length> sai-right: self.safe-area-insets.right;
    property <length> sai-bottom: self.safe-area-insets.bottom;
    changed sai-left => { Bridge.safe-area-left = self.sai-left; }
    changed sai-top => { Bridge.safe-area-top = self.sai-top; }
    changed sai-right => { Bridge.safe-area-right = self.sai-right; }
    changed sai-bottom => { Bridge.safe-area-bottom = self.sai-bottom; }
    init => {
        Bridge.safe-area-left = self.sai-left;
        Bridge.safe-area-top = self.sai-top;
        Bridge.safe-area-right = self.sai-right;
        Bridge.safe-area-bottom = self.sai-bottom;
    }

    property <bool> video-obstructed: Bridge.video-obstructed;
    changed video-obstructed => Bridge.video-obstructed-changed(self.video-obstructed);

    // The whole GUI is authored against one logical canvas and zoomed through
    // the window's scale factor, which is re-derived on every geometry change:
    // a resize, a fullscreen toggle or a move to another output.
    changed width => Bridge.window-geometry-changed();
    changed height => Bridge.window-geometry-changed();

    // The window's scale factor, which Slint exposes to .slint code only as the
    // ratio between the two length units. Watching it catches the platform
    // pushing a new DPI scale (a move to another output), which it does without
    // resizing us, so neither hook above would fire.
    property <float> scale-factor: 1px / 1phx;
    changed scale-factor => Bridge.window-geometry-changed();

    // The size setting applies to the live window: the drawer autosaves into
    // the cfg mirror, and this forwards the new value.
    property <string> ui-scale-cfg: Bridge.cfg-interface-ui-scale;
    changed ui-scale-cfg => Bridge.ui-scale-changed(self.ui-scale-cfg);

    // True only when the frame being rendered is PURELY the video-player scene: right
    // state AND none of the fading views (idle/loading/startup) still drawn over it.
    out property <bool> video-scene-clean: Bridge.app-state == AppState.Playing
        && Bridge.player-variant == UiPlayerVariant.Video
        && !idle-view.visible && !loading-view.visible && !startup-view.visible;

    property <bool> show-inspector: Bridge.show-inspector;
    changed show-inspector => {
        Bridge.inspector-toggled(self.show-inspector);
        if (!self.show-inspector) {
            fs.focus();
        }
    }

    // Key events are only delivered along the focused element's ancestor
    // chain, and are dropped entirely once the focused element is hidden or
    // destroyed (the window then has no focus item at all). `fs` wraps every
    // view so unhandled keys from any focused widget bubble up into the
    // global handler, and the watchers below reclaim focus whenever the
    // subtree that held it goes away.
    property <bool> settings-open: Bridge.show-settings;
    changed settings-open => {
        if (!self.settings-open) {
            // a field destroyed with the drawer never reports losing focus
            Bridge.text-edit-focused = false;
            fs.focus();
        }
    }

    property <bool> starting-up: Bridge.starting-up;
    changed starting-up => {
        if (!self.starting-up) {
            fs.focus();
        }
    }

    property <AppState> app-state: Bridge.app-state;
    changed app-state => {
        // On entry into Playing the video player's own scope focuses itself.
        if (self.app-state != AppState.Playing) {
            fs.focus();
        }
    }

    property <UiPlayerVariant> player-variant: Bridge.player-variant;
    changed player-variant => {
        if (self.player-variant != UiPlayerVariant.Video) {
            fs.focus();
        }
    }

    property <UiUpdaterState> updater-state: Bridge.updater-state;
    changed updater-state => fs.focus();

    // The popup's own FocusScope grabs focus on show; reclaim it on dismiss.
    property <bool> bug-report-visible: Bridge.bug-report-visible;
    changed bug-report-visible => {
        if (!self.bug-report-visible) {
            fs.focus();
        }
    }

    forward-focus: fs;

    fs := FocusScope {
        key-pressed(event) => Bridge.global-key-pressed(event);

        // A focused text field consumes arrows as cursor movement before
        // they can bubble. On TV, Up/Down must stay navigation or the
        // remote has no way out of the field, so take them in the capture
        // phase. Left/Right keep moving the cursor.
        capture-key-pressed(event) => {
            if Bridge.tv-mode && Bridge.text-edit-focused
                && (event.text == Key.UpArrow || event.text == Key.DownArrow) {
                Bridge.tab-nav-serial += 1;
                Bridge.remote-nav(event.text == Key.DownArrow);
                return accept;
            }
            reject
        }

        if Bridge.app-state == AppState.Playing && Bridge.player-variant == UiPlayerVariant.Video: VideoPlayerView { }

        if Bridge.app-state == AppState.Playing && Bridge.player-variant == UiPlayerVariant.Image: ImageView { }

        if Bridge.app-state == AppState.Playing && Bridge.player-variant == UiPlayerVariant.Audio: AudioPlayerView { }

        if Bridge.app-state == AppState.Playing && Bridge.player-variant == UiPlayerVariant.Raop: RaopView { }

        // A mid-playback server backoff would otherwise look like a silent
        // freeze; part of video-obstructed.
        if Bridge.app-state == AppState.Playing && Bridge.source-backoff-remaining-ms > 0: Rectangle {
            width: backoff-pill.preferred-width + 28px;
            height: 34px;
            x: (parent.width - self.width) / 2;
            y: 24px;
            border-radius: 17px;
            background: #000000B0;

            backoff-pill := HorizontalLayout {
                alignment: center;
                padding-left: 14px;
                padding-right: 14px;

                FText {
                    vertical-alignment: center;
                    font-size: 13px;
                    text: @tr("Waiting until media is available (ETA {}s)", Math.ceil(Bridge.source-backoff-remaining-ms / 1000.0));
                }
            }
        }

        idle-view := IdleView {
            opacity: Bridge.app-state == AppState.Idle ? 100% : 0%;
            visible: self.opacity > 0%;

            animate opacity {
                duration: 100ms;
            }
        }

        loading-view := LoadingMediaView {
            opacity: Bridge.app-state == AppState.LoadingMedia ? 100% : 0%;
            visible: self.opacity > 0%;

            animate opacity {
                duration: 100ms;
            }
        }

        if Bridge.should-show-toast-overlay(): ToastOverlay { }

        if Bridge.bug-report-visible: ReportBugPopup { }

        if Bridge.show-inspector: Inspector { }

        SettingsDrawer { }

        startup-view := StartupView {
            opacity: Bridge.starting-up ? 100% : 0%;
            visible: self.opacity > 0%;

            // The delay keeps this fully opaque until the idle view under
            // it finished fading in; both paint the same background art, so
            // the handoff is invisible. Without it the two half-opaque
            // layers over the translucent window dip to near black.
            animate opacity {
                duration: 250ms;
                delay: 120ms;
                easing: ease-in-out;
            }
        }
    }
}

export component SystemTray inherits SystemTrayIcon {
    icon: @image-url("../../../receivers/assets/icons/app/icon144.png");
    tooltip: "FCast Receiver";

    callback quit();
    callback toggle-window();

    clicked => toggle-window();

    Menu {
        MenuItem {
            title: "Toggle window";
            activated => toggle-window();
        }

        MenuSeparator {}

        MenuItem {
            title: "Quit";
            activated => quit();
        }
    }
}
