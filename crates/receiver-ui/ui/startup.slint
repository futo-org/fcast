import {
    FText,
    Button,
} from "../../../ui-components/std-widgets.slint";
import { FCastPalette } from "../../../ui-components/styling.slint";
import { Bridge, Assets } from "globals.slint";

component StartupText inherits FText {
    color: @linear-gradient(180deg, #FFFFFF 17.11%, #B4B4B4 78.95%);
    wrap: word-wrap;
    horizontal-alignment: center;
}

export component StartupView inherits Rectangle {
    Image {
        source: Assets.background-dark;
        width: 100%;
        height: 100%;
    }

    // Swallow input. Nothing behind should react before we're running.
    TouchArea { }

    VerticalLayout {
        alignment: center;
        padding: 40px;

        HorizontalLayout {
            // Spacers centre the content. `max-width` bounds it so text wraps
            // without referencing the root width (which would be a binding loop).
            Rectangle { }

            VerticalLayout {
                max-width: 560px;
                spacing: 24px;

                VerticalLayout {
                    // Fade the prompt in (like the idle view) rather than
                    // popping it in via an `if`.
                    opacity: Bridge.show-port-conflict ? 100% : 0%;
                    visible: self.opacity > 0%;
                    spacing: 16px;

                    animate opacity {
                        duration: 200ms;
                        easing: ease-in-out;
                    }

                    StartupText {
                        text: @tr("Another FCast receiver may already be running");
                        font-size: 28px;
                        font-weight: 600;
                        font-family: "Outfit Semibold";
                    }

                    StartupText {
                        text: @tr("Port {} is already in use, so this receiver can’t start normally. Close the other instance and retry, start this one on a different port, or quit.", Bridge.conflicting-port);
                        color: FCastPalette.opacity-light-500;
                        font-size: 15px;
                    }

                    StartupText {
                        text: @tr("On a different port, senders that discover receivers automatically will still find this one. Manual connections to the default port will not reach it.");
                        color: FCastPalette.opacity-light-500;
                        font-size: 13px;
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 12px;
                        padding-top: 8px;

                        Button {
                            text: @tr("Quit");
                            clicked => {
                                Bridge.port-conflict-quit();
                            }
                        }

                        Button {
                            text: @tr("Retry");
                            clicked => {
                                Bridge.port-conflict-retry();
                            }
                        }

                        Button {
                            text: @tr("Use a different port");
                            clicked => {
                                Bridge.port-conflict-use-different-port();
                            }
                        }
                    }
                }
            }

            Rectangle { }
        }
    }
}
