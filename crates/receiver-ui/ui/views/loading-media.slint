import { Icons, FText } from "../../../../ui-components/std-widgets.slint";
import { Assets, Bridge } from "../globals.slint";

export component LoadingMediaView inherits Rectangle {
    // A server-directed backoff fills the bar with the wait; otherwise it sweeps.
    property <bool> backing-off: Bridge.source-backoff-remaining-ms > 0
        && Bridge.source-backoff-total-ms > 0;
    property <int> backoff-seconds: Math.ceil(Bridge.source-backoff-remaining-ms / 1000.0);
    // While the view is up, which outlasts the loading state: a video item
    // is playing from its stream collection and the view stays until its
    // first frame. A source that names its streams before it has media
    // spends a server backoff there, with no text and the playing view's
    // notice under this one.
    in property <bool> active;
    // The background covers the video hole at once, the text and bar wait
    // 1500ms so a fast load flashes nothing.
    property <bool> content-shown: false;
    changed active => {
        if !self.active {
            self.content-shown = false;
        }
    }

    Timer {
        interval: 1500ms;
        running: root.active && !root.content-shown;
        triggered => {
            root.content-shown = true;
        }
    }

    Image {
        source: Assets.background-dark;
        width: 100%;
        height: 100%;
    }

    VerticalLayout {
        alignment: center;
        spacing: 14px;
        opacity: root.content-shown ? 1.0 : 0.0;
        animate opacity { duration: 150ms; }

        FText {
            text: root.backing-off
                ? @tr("Waiting until media is available")
                : @tr("Loading media...");
            horizontal-alignment: center;
        }

        if root.backing-off: FText {
            text: @tr("ETA {}s", root.backoff-seconds);
            horizontal-alignment: center;
            font-size: 13px;
            opacity: 70%;
        }

        // Guarded by active, not opacity: the view stays in the tree at
        // opacity 0 and an always-on animation-tick() would redraw forever.
        if root.active && root.content-shown: HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 220px;
                height: 4px;
                border-radius: 2px;
                background: #ffffff26;
                clip: true;

                // Two separate elements so a mode switch recreates the bar:
                // a fresh element takes its initial width instantly, while a
                // shared one would tween across modes (a new countdown slid
                // down from the sweep width instead of starting empty).
                if root.backing-off: Rectangle {
                    height: 100%;
                    border-radius: 2px;
                    background: #ffffffcc;
                    x: 0px;
                    // Fills left to right as the wait elapses.
                    width: parent.width * (1.0 - Bridge.source-backoff-remaining-ms / Bridge.source-backoff-total-ms);
                    // Smooth over the 250ms countdown ticks.
                    animate width { duration: 250ms; }
                }

                if !root.backing-off: Rectangle {
                    height: 100%;
                    border-radius: 2px;
                    background: #ffffffcc;
                    width: parent.width * 0.35;
                    x: -self.width + (parent.width + self.width) * mod(animation-tick(), 1.6s) / 1.6s;
                }
            }
        }
    }
}
