import {
    Icons,
    FText,
    Button,
} from "../../../../ui-components/std-widgets.slint";
import { Bridge, UiMode, AppState } from "../globals.slint";
import {
    PositionScrubber,
    ProgressLabels,
    MasterButton,
    ScrubbyMcScrub,
    VolumePreview,
} from "../common.slint";
import {
    FCastPalette,
} from "../../../../ui-components/styling.slint";

component PlaylistControlButton inherits Button {
    in property <bool> previous: false;

    width: 48px;
    height: 48px;
    icon: Icons.playlist-next;
    icon-rotation: previous ? 180deg : 0deg;
    colorize-icon: true;
    icon-size: 15px;
    background-default-color: @linear-gradient(133.14deg, rgba(52, 52, 52, 0.1) 6.7%, rgba(20, 20, 20, 0.1) 92.77%);

    clicked => {
        Bridge.select-playlist-item(Bridge.playlist-idx + (previous ? -1 : 1));
    }
}

// One crossfade layer: the image, or (when `placeholder` is set) the grey box
// with a music note if the layer's image is empty.
component CoverLayer inherits Rectangle {
    in property <image> src;
    in property <angle> rotation;
    in property <ImageFit> fit: ImageFit.contain;
    in property <bool> placeholder: true;

    if src.width > 0: Image {
        source: src;
        image-fit: fit;
        width: parent.width;
        height: parent.height;
        transform-rotation: rotation;
    }

    if src.width == 0 && placeholder: Rectangle {
        background: FCastPalette.neutral-1000;
        border-radius: 4px;

        Image {
            source: Icons.music-note;
            width: parent.width * 50%;
            height: parent.height * 52%;
        }
    }
}

// Crossfading cover image. It holds the current image through a short grace
// period when the source is cleared, so a quick track change (old cover to a
// transient empty to the new cover) crossfades straight to the new art instead
// of dipping through the empty state. A source that stays empty past the grace
// period fades out: to the music-note placeholder, or to nothing when
// `placeholder` is false.
component CrossfadeImage inherits Rectangle {
    in property <image> cover;
    in property <angle> cover-rotation;
    in property <ImageFit> fit: ImageFit.contain;
    in property <bool> placeholder: true;
    in property <duration> fade-duration: 250ms;
    in property <duration> grace-duration: 400ms;

    // True while a real image (not the empty/placeholder state) is settled on
    // top, so callers can fade a companion overlay (e.g. the darkening gradient)
    // in step with the crossfade.
    out property <bool> showing-image: settled-src().width > 0;

    // Two crossfade layers. Each holds its own image (an empty one renders the
    // placeholder or nothing); `show-front` selects which is on top.
    property <image> front-src;
    property <angle> front-rotation;
    property <image> back-src;
    property <angle> back-rotation;
    property <bool> show-front: true;

    clip: true;

    pure function settled-src() -> image {
        show-front ? front-src : back-src
    }

    // Move `img` into the hidden layer and flip to it, so the visible layer keeps
    // its old image and the two crossfade.
    function commit(img: image, rot: angle) {
        if show-front {
            back-src = img;
            back-rotation = rot;
            show-front = false;
        } else {
            front-src = img;
            front-rotation = rot;
            show-front = true;
        }
    }

    init => {
        if cover.width > 0 {
            commit(cover, cover-rotation);
        }
    }

    changed cover => {
        if cover.width > 0 {
            grace-timer.running = false;
            commit(cover, cover-rotation);
        } else if settled-src().width > 0 {
            grace-timer.running = false;
            if Bridge.app-state == AppState.Playing {
                // Cleared mid-playback (a track change): hold the current image
                // and wait out the grace period rather than dipping to the empty
                // state, in case a new cover is on the way.
                grace-timer.running = true;
            } else {
                // Leaving playback (e.g. a Stop): clear now instead of holding
                // the previous art on screen.
                commit(cover, cover-rotation);
            }
        }
    }

    grace-timer := Timer {
        interval: grace-duration;
        running: false;
        triggered => {
            self.running = false;
            if root.cover.width == 0 {
                root.commit(root.cover, root.cover-rotation);
            }
        }
    }

    CoverLayer {
        src: front-src;
        rotation: front-rotation;
        fit: root.fit;
        placeholder: root.placeholder;
        opacity: show-front ? 1.0 : 0.0;
        animate opacity {
            duration: fade-duration;
            easing: ease-in-out;
        }
    }

    CoverLayer {
        src: back-src;
        rotation: back-rotation;
        fit: root.fit;
        placeholder: root.placeholder;
        opacity: show-front ? 0.0 : 1.0;
        animate opacity {
            duration: fade-duration;
            easing: ease-in-out;
        }
    }
}

export component AudioPlayerView inherits Rectangle {
    background: FCastPalette.neutral-1100;

    // What the paddings, the labels, the scrubber and the buttons take next
    // to the cover in the large layout.
    property <length> chrome: 300px;
    // By height alone. This used to count the labels in, and a title or an
    // artist coming or going flipped the layout: a TV's 540px canvas sat
    // inside that band, so every track change flashed the large cover before
    // the tags brought the small one back. The switch sits where the two
    // layouts' height limits meet.
    property <bool> small-mode: root.height < 375px;

    // The labels hold their text through a track change, as the cover does.
    // The core clears them when the next item takes over and its tags bring
    // the new ones a moment later, and rows that left and came back moved the
    // whole column twice. A label that stays empty past the grace is dropped.
    property <string> title-src: Bridge.media-title;
    property <string> artist-src: Bridge.artist-name;
    property <string> shown-title;
    property <string> shown-artist;
    property <duration> label-grace: 400ms;

    init => {
        shown-title = title-src;
        shown-artist = artist-src;
    }

    changed title-src => {
        if title-src.is-empty && !shown-title.is-empty && Bridge.app-state != AppState.Idle {
            title-grace.running = true;
        } else {
            title-grace.running = false;
            shown-title = title-src;
        }
    }

    changed artist-src => {
        if artist-src.is-empty && !shown-artist.is-empty && Bridge.app-state != AppState.Idle {
            artist-grace.running = true;
        } else {
            artist-grace.running = false;
            shown-artist = artist-src;
        }
    }

    title-grace := Timer {
        interval: label-grace;
        running: false;
        triggered => {
            self.running = false;
            root.shown-title = root.title-src;
        }
    }

    artist-grace := Timer {
        interval: label-grace;
        running: false;
        triggered => {
            self.running = false;
            root.shown-artist = root.artist-src;
        }
    }

    blurred-bg := CrossfadeImage {
        width: 100%;
        height: 100%;
        fit: cover;
        placeholder: false;
        cover: Bridge.blured-audio-track-cover.img;
        cover-rotation: Bridge.blured-audio-track-cover.rotation;
    }

    Rectangle {
        background: Bridge.controls-bg-gradient;
        opacity: blurred-bg.showing-image ? 1.0 : 0.0;
        animate opacity {
            duration: 250ms;
            easing: ease-in-out;
        }
    }

    VerticalLayout {
        padding: !small-mode ? 58px : 10px;
        padding-bottom: 20px;
        spacing: 5px;
        alignment: center;

        if root.height > 300px: HorizontalLayout {
            alignment: center;

            pure function thumbnail-size() -> length {
                let width = Math.min(root.width * (!small-mode ? 35% : 10%), 400px);
                // large: half the height, or what the chrome leaves when
                // that is less
                let height = small-mode ? root.height * 20% : Math.min(root.height * 50%, root.height - chrome);
                Math.min(width, height)
            }

            CrossfadeImage {
                width: thumbnail-size();
                height: self.width;
                border-radius: 4px;
                cover: Bridge.audio-track-cover.img;
                cover-rotation: Bridge.audio-track-cover.rotation;
            }
        }

        Rectangle {
            height: !small-mode ? 10px : 5px;
        }

        if !shown-title.is-empty: FText {
            horizontal-alignment: center;
            text: shown-title;
            // one line: a long tag title pushed the controls off screen
            overflow: elide;
            font-size: 28px;
            font-weight: 600;
            color: FCastPalette.neutral-100;
        }

        if !shown-artist.is-empty: FText {
            horizontal-alignment: center;
            text: shown-artist;
            // one line: a long tag title pushed the controls off screen
            overflow: elide;
            font-size: 18px;
            font-weight: 600;
            color: FCastPalette.opacity-light-500;
        }

        Rectangle {
            height: 20px;
        }

        ScrubbyMcScrub { }

        if Bridge.ui-mode == UiMode.Full: HorizontalLayout {
            alignment: center;
            spacing: 30px;

            VerticalLayout {
                visible: Bridge.playlist-idx != 0 && Bridge.playlist-length != 0;
                alignment: center;

                PlaylistControlButton {
                    previous: true;
                }
            }

            MasterButton { }

            VerticalLayout {
                visible: Bridge.playlist-idx < Bridge.playlist-length - 1;
                alignment: center;

                PlaylistControlButton { }
            }
        }
    }

    // The next item loads behind this view: a thin sweep along the top edge,
    // only once the load is slow enough to notice.
    Rectangle {
        y: 0;
        width: 100%;
        height: 3px;
        clip: true;
        opacity: Bridge.app-state == AppState.LoadingMedia ? 1.0 : 0.0;
        animate opacity {
            delay: 1500ms;
            duration: 200ms;
        }

        // Guarded by app-state: an always-on animation-tick() would redraw forever.
        if Bridge.app-state == AppState.LoadingMedia: Rectangle {
            height: 100%;
            background: #ffffffcc;
            width: parent.width * 0.35;
            x: -self.width + (parent.width + self.width) * mod(animation-tick(), 1.6s) / 1.6s;
        }
    }

    VolumePreview {
        width: 100%;
        height: 100%;
    }
}
