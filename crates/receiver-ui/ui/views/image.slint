import { Bridge } from "../globals.slint";
import { VideoFrame } from "../common.slint";

export component ImageView inherits Rectangle {
    width: 100%;
    height: 100%;
    // Most images are decoded by the player pipeline (fimagedec) and presented
    // by the video sink: for those `image-via-player` is set and the frame is
    // drawn exactly as the video view draws it, in the window on desktop and
    // as a hole onto the surface behind the window on android. This view
    // still handles stills for the formats the pipeline cannot route.
    // decodebin3 autoplugs a decoder off a typefinder, so a format with no
    // reliable magic bytes (TGA, whose only signature is an optional trailing
    // footer) plus any image mime not in fimagedec's whitelist fall back to
    // the in-GUI image decoder, which paints its decoded frame here over a
    // black backdrop.
    background: Bridge.image-via-player ? transparent : black;

    if Bridge.image-via-player: VideoFrame { }

    if !Bridge.image-via-player && Bridge.image-preview.img.width > 0: Image {
        source: Bridge.image-preview.img;
        image-fit: contain;
        width: 100%;
        height: 100%;
        transform-rotation: Bridge.image-preview.rotation;
    }
}
