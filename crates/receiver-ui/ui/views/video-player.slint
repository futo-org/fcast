import {
    Icons,
    FText,
    ScrollView,
    Button,
    ListView,
} from "../../../../ui-components/std-widgets.slint";
import {
    AppState,
    Bridge,
    UiMediaTrack,
    GuiPlaybackState,
    UiMediaTrackType,
    UiMode,
    UiPlayerVariant,
} from "../globals.slint";
import {
    PositionScrubber,
    ProgressLabels,
    MasterButton,
    ScrubbyMcScrub,
    VolumePreview,
} from "../common.slint";
import {
    FCastPalette,
    RowTint,
} from "../../../../ui-components/styling.slint";

component SecondaryButton inherits Button {
    icon-size: 18px;
    width: 45px;
    height: 45px;
    background-default-color: @linear-gradient(133.14deg, rgba(204, 204, 204, 0.1) 6.7%, rgba(122, 122, 122, 0.1) 92.77%);
    background-blur: 34px;
    colorize-icon: true;
}

// The side bar header's action button: close on the start page, back on the
// others. It draws its own ring because the side bar's keyboard cursor decides
// what is highlighted, not slint focus.
component HeaderButton inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: 13px;
    in property <angle> button-rotation: 0deg;
    in property <bool> focused;

    callback clicked;
    // The side bar's cursor follows the pointer, so hovering has to report in.
    callback hovered;

    width: 34px;
    height: 34px;

    btn := Button {
        width: root.width;
        height: root.height;
        icon: root.icon;
        icon-size: root.icon-size;
        transform-rotation: root.button-rotation;
        colorize-icon: true;

        clicked => {
            root.clicked();
        }
        changed has-hover => {
            if btn.has-hover {
                root.hovered();
            }
        }
    }

    if root.focused: Rectangle {
        border-radius: root.height / 2;
        background: RowTint.focused;
    }
}

component PlaybackSettingsMenuItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    // True when the side bar's keyboard cursor sits on this row.
    in property <bool> focused;

    callback clicked;
    callback hovered;

    states [
        focused when root.focused: {
            text.color: FCastPalette.foreground;
            arrow-icon.colorize: FCastPalette.foreground;
            background: RowTint.focused;
        }
        hover when i-ta.has-hover: {
            text.color: FCastPalette.foreground;
            arrow-icon.colorize: FCastPalette.foreground;
            background: RowTint.hovered;
        }
    ]
    animate background { duration: 100ms; }

    i-ta := TouchArea {
        clicked => root.clicked();
        mouse-cursor: pointer;

        changed has-hover => {
            if i-ta.has-hover {
                root.hovered();
            }
        }
    }

    HorizontalLayout {
        padding-left: 24px;
        padding-right: 20px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 8px;

        VerticalLayout {
            alignment: center;

            Image {
                width: 16px;
                height: 16px;
                source: icon;
            }
        }

        text := FText {
            text: label;
            color: FCastPalette.neutral-500;
        }

        Rectangle { }

        VerticalLayout {
            alignment: center;

            arrow-icon := Image {
                width: 4.67px;
                height: 8px;
                source: Icons.arrow-right;
            }
        }
    }
}

component SettingItem inherits Rectangle {
    in property <string> value;
    in property <bool> selected;
    // True when the side bar's keyboard cursor sits on this row. A tint laid
    // over the background, so it reads on the selected row's gradient too.
    in property <bool> focused;

    callback clicked;
    callback hovered;

    states [
        selected when selected: {
            background: @linear-gradient(90.92deg, #2D7AF8 0.79%, #0757D9 104.49%);
            icon.source: Icons.check-tick;
        }
        hover when ta.has-hover: {
            background: RowTint.hovered;
        }
    ]

    ta := TouchArea {
        mouse-cursor: pointer;

        clicked => clicked();

        changed has-hover => {
            if ta.has-hover {
                root.hovered();
            }
        }
    }

    if root.focused: Rectangle {
        background: RowTint.focused;
    }

    HorizontalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        padding-left: 24px;
        padding-right: 20px;
        spacing: 8px;

        FText {
            horizontal-stretch: 1;
            text: value;
            overflow: elide;
        }

        VerticalLayout {
            alignment: center;

            icon := Image {
                source: Icons.arrow-right;
            }
        }
    }
}

component PlaybackSettingHeader inherits HorizontalLayout {
    in property <string> title;
    in property <bool> focused;

    callback navigate-previous;
    callback hovered;

    spacing: 15px;
    padding-left: 15px;
    padding-right: 15px;

    HeaderButton {
        icon: Icons.arrow-right;
        icon-size: 8px;
        width: 30px;
        height: 30px;
        button-rotation: 180deg;
        focused: root.focused;

        clicked => navigate-previous();
        hovered => root.hovered();
    }

    FText {
        text: title;
        font-weight: 500;
        font-size: 18px;
        vertical-alignment: center;
    }
}

component SettingsTrackList inherits Rectangle {
    in property <[UiMediaTrack]> tracks;
    in property <int> selected-id;
    in property <bool> can-be-disabled: false;
    // Keyboard cursor row of the owning page, -1 when the keyboard is elsewhere.
    // Row 0 is the "Off" row when the list has one, the tracks follow.
    in property <int> cursor: -1;

    callback clicked(id: int);
    // Reported by whichever row is the current selection, so the page can park
    // its cursor there. Rows push it because slint has no index-of on a model.
    callback selected-row(row: int);
    callback hovered(row: int);

    property <int> off-rows: can-be-disabled ? 1 : 0;
    property <int> row-count: tracks.length + off-rows;
    // Rows are uniform, so one division beats measuring each of them.
    property <length> row-height: row-count > 0 ? sv.viewport-height / row-count : 0px;

    changed cursor => {
        root.scroll-into-view(root.cursor);
    }

    function scroll-into-view(index: int) {
        if index < 0 || root.row-count == 0 {
            return;
        }
        if sv.viewport-y + index * root.row-height < 0px {
            sv.viewport-y = -index * root.row-height;
        }
        if sv.viewport-y + (index + 1) * root.row-height > sv.visible-height {
            sv.viewport-y = sv.visible-height - (index + 1) * root.row-height;
        }
    }

    sv := ScrollView {
        viewport-height: vl.preferred-height;

        vl := VerticalLayout {
            if can-be-disabled: SettingItem {
                value: @tr("Off");
                selected: selected-id == -1;
                focused: root.cursor == 0;

                init => {
                    if self.selected {
                        root.selected-row(0);
                    }
                }
                changed selected => {
                    if self.selected {
                        root.selected-row(0);
                    }
                }

                hovered => root.hovered(0);

                clicked => clicked(-1);
            }

            Rectangle {
                height: 1px;
                background: #FFFFFF0A;
            }

            for track[i] in tracks: VerticalLayout {
                SettingItem {
                    value: track.name;
                    selected: selected-id == track.id;
                    focused: root.cursor == i + root.off-rows;

                    init => {
                        if self.selected {
                            root.selected-row(i + root.off-rows);
                        }
                    }
                    changed selected => {
                        if self.selected {
                            root.selected-row(i + root.off-rows);
                        }
                    }

                    hovered => root.hovered(i + root.off-rows);

                    clicked => clicked(track.id);
                }

                Rectangle {
                    height: 1px;
                    background: #FFFFFF0A;
                }
            }
        }
    }
}

component ButtonControls inherits Rectangle {
    in property <float> fade: 1.0;

    callback show-settings();

    HorizontalLayout {
        alignment: space-between;

        Rectangle {
            width: right-side-ctrls.preferred-width;
        }

        Rectangle {
            MasterButton {
                height: 50px;
                width: 50px;
                fade: root.fade;
            }
        }

        right-side-ctrls := HorizontalLayout {
            alignment: end;
            spacing: 15px;

            settings-btn := SecondaryButton {
                icon: Icons.settings;
                fade: root.fade;
                clicked => show-settings();
            }
        }
    }
}

enum SettingsPage {
    Start,
    Video,
    Audio,
    Subtitle,
    Rate,
}

component PlaybackControls inherits Rectangle {
    out property <MouseCursor> suggested-cursor: default;
    // Driven by the parent: true while the pointer is anywhere inside the window.
    in property <bool> pointer-inside-window: true;

    property <bool> is-changing-volume: false;
    property <float> background-height: 100%;
    property <float> elems-opacity: 0%;
    property <bool> is-visible: false;
    property <bool> show-settings: false;
    property <SettingsPage> current-settings-page: SettingsPage.Start;

    // Keyboard state of the settings side bar: one cursor index over the rows of
    // the current page, in declaration order, with row 0 being the header button
    // (close on the start page, back on the others). The side bar's FocusScope
    // owns the keyboard while it is open and consumes Tab itself, so traversal
    // can never wander off into the controls behind it.
    property <int> settings-cursor: 1;
    // True after keyboard navigation in the side bar, false again on hover.
    // The focus ring only draws while it is true, hover keeps its own highlight.
    property <bool> settings-kb-nav: false;
    property <[float]> rates: [0.25, 0.5, 0.75, 1.0, 1.25, 1.50, 1.75, 2.0];

    // The row holding the current value on each options page, as reported by that
    // page's rows (see `note-selected-row`). The start page's is the category row
    // the user left from, so backing out returns to it.
    property <int> selected-row-start: 1;
    property <int> selected-row-video: 1;
    property <int> selected-row-audio: 1;
    property <int> selected-row-subtitle: 1;
    property <int> selected-row-rate: 1;

    // Start page row layout: a menu entry per track kind that has tracks, then
    // playback speed. -1 means the entry is not shown.
    property <int> n-video: Bridge.video-tracks.length > 0 ? 1 : 0;
    property <int> n-audio: Bridge.audio-tracks.length > 0 ? 1 : 0;
    property <int> n-subtitle: Bridge.subtitle-tracks.length > 0 ? 1 : 0;
    property <int> row-video: n-video > 0 ? 1 : -1;
    property <int> row-audio: n-audio > 0 ? 1 + n-video : -1;
    property <int> row-subtitle: n-subtitle > 0 ? 1 + n-video + n-audio : -1;
    property <int> row-rate: 1 + n-video + n-audio + n-subtitle;

    property <int> page-row-count: current-settings-page == SettingsPage.Start ? row-rate + 1
        : current-settings-page == SettingsPage.Video ? 1 + Bridge.video-tracks.length
        : current-settings-page == SettingsPage.Audio ? 1 + Bridge.audio-tracks.length
        : current-settings-page == SettingsPage.Subtitle ? 2 + Bridge.subtitle-tracks.length
        : 1 + rates.length;

    // Tracks come and go mid-playback, so never leave the cursor past the end.
    changed page-row-count => {
        if settings-cursor >= page-row-count {
            settings-cursor = max(page-row-count - 1, 0);
        }
    }

    public function open-settings() {
        current-settings-page = SettingsPage.Start;
        // A fresh open starts at the top, on the first real row rather than on the
        // header button. Only backing out of a category returns to it.
        selected-row-start = 1;
        settings-cursor = 1;
        settings-kb-nav = false;
        show-settings = true;
        settings-focus.focus();
    }

    public function close-settings() {
        show-settings = false;
        current-settings-page = SettingsPage.Start;
        settings-cursor = 1;
        // Closing hides the side bar, which drops whatever focus lived inside it.
        focus.focus();
    }

    function open-page(page: SettingsPage) {
        // Stepping into a category remembers which one, so backing out of it lands
        // on that row instead of at the top of the menu.
        if current-settings-page == SettingsPage.Start && page != SettingsPage.Start {
            selected-row-start = settings-cursor;
        }
        current-settings-page = page;
        park-cursor(remembered-row(page));
    }

    // Entering a category by mouse moves the cursor onto its row first, so the
    // way back is the same whichever way it was entered.
    function enter-category(page: SettingsPage, row: int) {
        park-cursor(row);
        open-page(page);
    }

    // Parking the cursor on the row that holds the current value means tabbing
    // into a list starts from what is selected instead of from the top.
    function park-cursor(row: int) {
        settings-cursor = max(0, min(row, page-row-count - 1));
    }

    // Mouse twin of park-cursor, used by the hover callbacks. Hover moves the
    // cursor but must not draw the keyboard ring, so it drops the flag first.
    function hover-park(row: int) {
        settings-kb-nav = false;
        park-cursor(row);
    }

    pure function remembered-row(page: SettingsPage) -> int {
        if page == SettingsPage.Video {
            return selected-row-video;
        }
        if page == SettingsPage.Audio {
            return selected-row-audio;
        }
        if page == SettingsPage.Subtitle {
            return selected-row-subtitle;
        }
        if page == SettingsPage.Rate {
            return selected-row-rate;
        }
        return selected-row-start;
    }

    // A page's rows report which one is the current value, since slint has no
    // index-of on a model. It has to be remembered outside the page: the
    // conditional that mounts a page reuses its instance, so re-entering it runs
    // no `init` and would otherwise park on the row from the first visit.
    function note-selected-row(page: SettingsPage, row: int) {
        if page == SettingsPage.Video {
            selected-row-video = row;
        } else if page == SettingsPage.Audio {
            selected-row-audio = row;
        } else if page == SettingsPage.Subtitle {
            selected-row-subtitle = row;
        } else {
            selected-row-rate = row;
        }
        if page == current-settings-page {
            park-cursor(row);
        }
    }

    function move-cursor(delta: int) {
        if page-row-count <= 0 {
            return;
        }
        settings-kb-nav = true;
        settings-cursor += delta;
        if settings-cursor < 0 {
            settings-cursor = page-row-count - 1;
        }
        if settings-cursor >= page-row-count {
            settings-cursor = 0;
        }
    }

    function activate-cursor() {
        settings-kb-nav = true;
        // A page can lose all its rows mid-playback (tracks going away).
        if page-row-count <= 0 {
            return;
        }
        if settings-cursor == 0 {
            // The header button: out of the side bar, or back one page.
            if current-settings-page == SettingsPage.Start {
                close-settings();
            } else {
                open-page(SettingsPage.Start);
            }
            return;
        }
        if current-settings-page == SettingsPage.Start {
            if settings-cursor == row-video {
                enter-category(SettingsPage.Video, row-video);
            } else if settings-cursor == row-audio {
                enter-category(SettingsPage.Audio, row-audio);
            } else if settings-cursor == row-subtitle {
                enter-category(SettingsPage.Subtitle, row-subtitle);
            } else {
                enter-category(SettingsPage.Rate, row-rate);
            }
            return;
        }
        if current-settings-page == SettingsPage.Video {
            Bridge.select-track(Bridge.video-tracks[settings-cursor - 1].id, UiMediaTrackType.Video);
            return;
        }
        if current-settings-page == SettingsPage.Audio {
            Bridge.select-track(Bridge.audio-tracks[settings-cursor - 1].id, UiMediaTrackType.Audio);
            return;
        }
        if current-settings-page == SettingsPage.Subtitle {
            // Row 1 is "Off", the tracks follow.
            select-subtitle(settings-cursor == 1 ? -1 : Bridge.subtitle-tracks[settings-cursor - 2].id);
            return;
        }
        set-rate(rates[settings-cursor - 1]);
    }

    function select-subtitle(id: int) {
        Bridge.current-subtitle-track = id;
        Bridge.select-track(id, UiMediaTrackType.Subtitle);
    }

    function set-rate(rate: float) {
        Bridge.change-playback-rate(rate);
        Bridge.playback-rate = rate;
    }

    forward-focus: focus;

    // True while any part of the controls is drawn over the video. Mirrored into the
    // Bridge so the video sink knows when its subsurface may sit above the GUI.
    property <bool> obstructing: is-visible
        || show-settings
        || elems-opacity > 0
        || background-height < 100%
        || settings-side-bar.width > 0px;

    changed obstructing => {
        Bridge.controls-overlay-visible = self.obstructing;
        if (!self.obstructing && !Bridge.show-settings) {
            focus.focus();
        }
    }

    changed pointer-inside-window => {
        // Don't yank the controls away mid-scrub if the pointer slips out of the window while
        // dragging (mirrors the idle timer's guard). On touch, hover dies on every
        // finger-up, so only the idle timer hides there.
        if !Bridge.touch-mode && !self.pointer-inside-window && !Bridge.is-scrubbing-position {
            close();
        }
    }

    init => {
        Bridge.controls-overlay-visible = self.obstructing;
    }

    animate elems-opacity, background-height {
        duration: 200ms;
        easing: ease-out-expo;
    }

    VerticalLayout {
        visible: background-height < 100%;

        Rectangle {
            background: @linear-gradient(0deg, rgba(0, 0, 0, 0.0), rgba(0, 0, 0, 0.8) 100%);
        }

        Rectangle {
            height: parent.height * background-height;
        }

        Rectangle {
            background: @linear-gradient(0deg, rgba(0, 0, 0, 1.0) 0%, rgba(0, 0, 0, 0.0) 100%);
        }
    }

    public function show() {
        reveal(true);
    }

    // `unhide-cursor` is false for keyboard wake-ups: a Tab should not conjure a
    // mouse pointer the user never moved.
    function reveal(unhide-cursor: bool) {
        tim.restart();
        if is-visible {
            return;
        }

        is-visible = true;
        background-height = 20%;
        elems-opacity = 100%;
        tim.running = true;
        // the remote lands on the seek bar first, like the Kotlin receiver
        if Bridge.tv-mode {
            scrub.focus-scrubber();
        }
        if unhide-cursor {
            suggested-cursor = MouseCursor.default;
            Bridge.set-cursor-hidden(false);
        }
    }

    // Tab is how the keyboard reaches the controls, so it wakes them like a
    // pointer move does and pushes the hide timer out while it walks them.
    function wake-controls() {
        if is-visible {
            tim.restart();
            return;
        }
        reveal(false);
    }

    // Every Tab that no widget consumed bumps this, which is the only way the
    // controls hear about tab presses that landed on one of their own buttons
    // (those bubble straight past this component to the window-wide scope).
    property <int> keyboard-nav: Bridge.tab-nav-serial;
    changed keyboard-nav => {
        root.wake-controls();
    }

    // The global Back handling peels the chrome as its own layer on TV.
    property <int> osd-close: Bridge.osd-close-serial;
    changed osd-close => {
        root.close-settings();
        root.close();
    }

    public function close() {
        is-visible = false;
        background-height = 100%;
        elems-opacity = 0%;
        tim.running = false;
        suggested-cursor = MouseCursor.none;
    }

    // TODO: handle the case when focus leaves window
    ta := TouchArea {
        mouse-cursor: suggested-cursor;

        double-clicked => Bridge.toggle-fullscreen();

        clicked => {
            // touch has no hover to reveal with: a tap on the video toggles
            // the controls instead (button taps never reach this area)
            if Bridge.touch-mode && !show-settings {
                if is-visible {
                    root.close();
                } else {
                    root.show();
                }
            }
            root.close-settings();
        }

        pointer-event(pe) => {
            // touch taps leak micro-moves on release, which would re-reveal
            // right after the tap-to-hide; on touch only the tap toggles
            if (pe.kind == PointerEventKind.move && !Bridge.touch-mode) {
                parent.show();
            }
        }

        // This scope anchors focus while the video scene is up, reacts to window
        // activation, and turns the first Tab into a wake-up. Everything else
        // bubbles to the global FocusScope in main.slint.
        focus := FocusScope {
            focus-changed-event(event) => {
                if (event == FocusReason.window-activation && is-visible) {
                    root.close();
                }
            }

            key-pressed(event) => {
                if event.text != Key.Tab && event.text != Key.Backtab {
                    return reject;
                }
                // With the controls hidden there is nothing to tab to, so this
                // press only reveals them and the next one starts walking.
                if !is-visible {
                    root.wake-controls();
                    return accept;
                }

                root.wake-controls();
                return reject;
            }

            init => self.focus();
        }
    }

    main-vlayout := VerticalLayout {
        padding-left: 58px + Bridge.safe-area-left;
        padding-right: 58px + Bridge.safe-area-right;
        padding-top: 20px + Bridge.safe-area-top;
        padding-bottom: 20px + Bridge.safe-area-bottom;
        spacing: 5px;

        if Bridge.ui-mode == UiMode.Full: HorizontalLayout {
            visible: elems-opacity > 0;

            SecondaryButton {
                fade: elems-opacity;
                icon: Icons.close;
                icon-rotation: 180deg;
                icon-size: 14px;

                clicked => Bridge.stop-playback();
            }

            Rectangle { }

            SecondaryButton {
                fade: elems-opacity;
                icon: Bridge.is-fullscreen ? Icons.minimize : Icons.maximize;

                clicked => Bridge.toggle-fullscreen();
            }
        }

        Rectangle { }

        ctrl-layout := Rectangle {
            height: self.preferred-height * elems-opacity;
            visible: is-visible;

            VerticalLayout {
                HorizontalLayout {
                    opacity: elems-opacity;
                    visible: is-visible;
                    padding: 10px;
                    padding-bottom: 15px;

                    // Single line, elided: long tag titles word-wrapped into
                    // a column filling half the portrait screen.
                    FText {
                        text: Bridge.media-title;
                        width: 50%;
                        overflow: elide;
                        font-size: 24px;
                        font-weight: 500;
                        vertical-alignment: center;
                        color: FCastPalette.neutral-100;
                    }

                    Rectangle { /* Spacer */ }

                    if Bridge.is-live: VerticalLayout {
                        opacity: elems-opacity;

                        Rectangle { }

                        Rectangle {
                            background: #FB2C2C;
                            border-radius: 3.3px;
                            width: i-hl.preferred-width;

                            i-hl := HorizontalLayout {
                                padding: 12px;
                                padding-top: 6px;
                                padding-bottom: self.padding-top;
                                spacing: 6px;

                                VerticalLayout {
                                    alignment: center;

                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 5px;
                                        background: FCastPalette.foreground;
                                    }
                                }

                                FText {
                                    text: @tr("LIVE");
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                scrub := ScrubbyMcScrub {
                    fade: elems-opacity;
                    visible: is-visible;
                    height: is-visible ? self.preferred-height : 0px;
                }

                if Bridge.ui-mode == UiMode.Full: Rectangle {
                    height: 5px;
                }

                if Bridge.ui-mode == UiMode.Full: ButtonControls {
                    fade: elems-opacity;
                    visible: is-visible;

                    show-settings => {
                        root.open-settings();
                    }
                }
            }
        }
    }

    HorizontalLayout {
        // `show-settings` keeps the panel drawn from the very first frame of the
        // slide-in, so the focus handed to `settings-focus` lands on a visible item.
        visible: show-settings || settings-side-bar.width > 0px;

        Rectangle {}

        settings-side-bar := Rectangle {
            // Same panel as the settings drawer: opaque, flush against the right
            // edge, with a 1px left divider. No frost, so nothing tints the video.
            background: @linear-gradient(180deg, #101010 0%, #0F0F10 100%);
            width: show-settings ? min(360px, root.width * 0.5) : 0px;
            animate width {
                duration: 100ms;
            }

            // Left edge divider.
            Rectangle {
                x: 0;
                width: 1px;
                background: FCastPalette.opacity-light-1000;
            }

            // The side bar is modal for the keyboard: it holds focus while open
            // (handed over by `open-settings`) and swallows Tab, so tab traversal
            // never reaches the controls or the buttons behind the panel. Rows are
            // driven by `settings-cursor`, not by per-row focus, so this scope
            // needs no clicks: `focus-on-click` off keeps it from shadowing the
            // row touch areas below it.
            settings-focus := FocusScope {
                focus-on-click: false;

                key-pressed(event) => {
                    if event.text == Key.Escape {
                        root.close-settings();
                        return accept;
                    }
                    // The remote's back button peels one page, then closes.
                    if event.text == Key.Back {
                        if current-settings-page != SettingsPage.Start {
                            root.settings-kb-nav = true;
                            root.open-page(SettingsPage.Start);
                        } else {
                            root.close-settings();
                        }
                        return accept;
                    }
                    if event.text == Key.Tab {
                        root.move-cursor(event.modifiers.shift ? -1 : 1);
                        return accept;
                    }
                    if event.text == Key.Backtab || event.text == Key.UpArrow {
                        root.move-cursor(-1);
                        return accept;
                    }
                    if event.text == Key.DownArrow {
                        root.move-cursor(1);
                        return accept;
                    }
                    if event.text == Key.Return || event.text == Key.Space || event.text == Key.RightArrow {
                        root.activate-cursor();
                        return accept;
                    }
                    // Left is "back out of this page", and a no-op on the start page.
                    if (event.text == Key.LeftArrow || event.text == Key.Backspace)
                        && current-settings-page != SettingsPage.Start {
                        root.settings-kb-nav = true;
                        root.open-page(SettingsPage.Start);
                        return accept;
                    }

                    return reject;
                }
            }

            TouchArea {}

            if current-settings-page == SettingsPage.Start: VerticalLayout {
                padding-top: 18px;
                padding-bottom: 15px;

                HorizontalLayout {
                    spacing: 12px;
                    padding-left: 15px;
                    padding-right: 15px;

                    FText {
                        text: @tr("Playback settings");
                        font-weight: 500;
                        font-size: 18px;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }

                    HeaderButton {
                        icon: Icons.close;
                        icon-size: 13px;
                        focused: settings-kb-nav && settings-cursor == 0;

                        clicked => {
                            root.close-settings();
                        }
                        hovered => {
                            root.hover-park(0);
                        }
                    }
                }

                // Who this stream is from, for the one that arrives unasked.
                if Bridge.senders.length > 0: HorizontalLayout {
                    padding-left: 15px;
                    padding-right: 15px;

                    FText {
                        text: Bridge.senders.length == 1
                            ? @tr("Casting from {}", Bridge.senders[0].name == "" ? Bridge.senders[0].app : Bridge.senders[0].name)
                            : @tr("Casting from {} and {} more", Bridge.senders[0].name == "" ? Bridge.senders[0].app : Bridge.senders[0].name, Bridge.senders.length - 1);
                        font-size: 12px;
                        color: FCastPalette.opacity-light-500;
                        overflow: elide;
                    }
                }

                VerticalLayout {
                    padding-top: 10px;

                    if Bridge.video-tracks.length > 0: PlaybackSettingsMenuItem {
                        label: @tr("Video");
                        icon: Icons.settings-video;
                        focused: settings-kb-nav && settings-cursor == row-video;

                        clicked => {
                            root.enter-category(SettingsPage.Video, row-video);
                        }
                        hovered => {
                            root.hover-park(row-video);
                        }
                    }

                    if Bridge.audio-tracks.length > 0: PlaybackSettingsMenuItem {
                        label: @tr("Audio");
                        icon: Icons.details-audio;
                        focused: settings-kb-nav && settings-cursor == row-audio;

                        clicked => {
                            root.enter-category(SettingsPage.Audio, row-audio);
                        }
                        hovered => {
                            root.hover-park(row-audio);
                        }
                    }

                    if Bridge.subtitle-tracks.length > 0: PlaybackSettingsMenuItem {
                        label: @tr("Subtitles");
                        icon: Icons.subtitles;
                        focused: settings-kb-nav && settings-cursor == row-subtitle;

                        clicked => {
                            root.enter-category(SettingsPage.Subtitle, row-subtitle);
                        }
                        hovered => {
                            root.hover-park(row-subtitle);
                        }
                    }

                    PlaybackSettingsMenuItem {
                        label: @tr("Playback Speed");
                        icon: Icons.playback-rate;
                        focused: settings-kb-nav && settings-cursor == row-rate;

                        clicked => {
                            root.enter-category(SettingsPage.Rate, row-rate);
                        }
                        hovered => {
                            root.hover-park(row-rate);
                        }
                    }

                    Rectangle {}
                }
            }

            if current-settings-page == SettingsPage.Video: VerticalLayout {
                padding-top: 18px;
                padding-bottom: 15px;

                PlaybackSettingHeader {
                    title: @tr("Video track");
                    focused: settings-kb-nav && settings-cursor == 0;

                    navigate-previous => {
                        root.open-page(SettingsPage.Start);
                    }
                    hovered => {
                        root.hover-park(0);
                    }
                }

                VerticalLayout {
                    padding-top: 10px;

                    SettingsTrackList {
                        tracks: Bridge.video-tracks;
                        selected-id: Bridge.current-video-track;
                        cursor: settings-kb-nav ? settings-cursor - 1 : -1;
                        selected-row(row) => {
                            root.note-selected-row(SettingsPage.Video, row + 1);
                        }
                        hovered(row) => {
                            root.hover-park(row + 1);
                        }
                        clicked(id) => Bridge.select-track(id, UiMediaTrackType.Video);
                    }
                }
            }

            if current-settings-page == SettingsPage.Audio: VerticalLayout {
                padding-top: 18px;
                padding-bottom: 15px;

                PlaybackSettingHeader {
                    title: @tr("Audio track");
                    focused: settings-kb-nav && settings-cursor == 0;

                    navigate-previous => {
                        root.open-page(SettingsPage.Start);
                    }
                    hovered => {
                        root.hover-park(0);
                    }
                }

                VerticalLayout {
                    padding-top: 10px;

                    SettingsTrackList {
                        tracks: Bridge.audio-tracks;
                        selected-id: Bridge.current-audio-track;
                        cursor: settings-kb-nav ? settings-cursor - 1 : -1;
                        selected-row(row) => {
                            root.note-selected-row(SettingsPage.Audio, row + 1);
                        }
                        hovered(row) => {
                            root.hover-park(row + 1);
                        }
                        clicked(id) => Bridge.select-track(id, UiMediaTrackType.Audio);
                    }
                }
            }

            if current-settings-page == SettingsPage.Subtitle: VerticalLayout {
                padding-top: 18px;
                padding-bottom: 15px;

                PlaybackSettingHeader {
                    title: @tr("Subtitle track");
                    focused: settings-kb-nav && settings-cursor == 0;

                    navigate-previous => {
                        root.open-page(SettingsPage.Start);
                    }
                    hovered => {
                        root.hover-park(0);
                    }
                }

                VerticalLayout {
                    padding-top: 10px;

                    SettingsTrackList {
                        tracks: Bridge.subtitle-tracks;
                        selected-id: Bridge.current-subtitle-track;
                        can-be-disabled: true;
                        cursor: settings-kb-nav ? settings-cursor - 1 : -1;
                        selected-row(row) => {
                            root.note-selected-row(SettingsPage.Subtitle, row + 1);
                        }
                        hovered(row) => {
                            root.hover-park(row + 1);
                        }
                        clicked(id) => {
                            root.select-subtitle(id);
                        }
                    }
                }
            }

            if current-settings-page == SettingsPage.Rate: VerticalLayout {
                padding-top: 18px;
                padding-bottom: 15px;

                PlaybackSettingHeader {
                    title: @tr("Playback speed");
                    focused: settings-kb-nav && settings-cursor == 0;

                    navigate-previous => {
                        root.open-page(SettingsPage.Start);
                    }
                    hovered => {
                        root.hover-park(0);
                    }
                }

                VerticalLayout {
                    padding-top: 10px;

                    // No scroll-into-view here: the eight rates always fit the panel.
                    ListView {
                        for rate[i] in root.rates: VerticalLayout {
                            SettingItem {
                                value: rate;
                                selected: Bridge.playback-rate == rate;
                                focused: settings-kb-nav && settings-cursor == i + 1;

                                init => {
                                    if self.selected {
                                        root.note-selected-row(SettingsPage.Rate, i + 1);
                                    }
                                }
                                changed selected => {
                                    if self.selected {
                                        root.note-selected-row(SettingsPage.Rate, i + 1);
                                    }
                                }

                                hovered => {
                                    root.hover-park(i + 1);
                                }

                                clicked => {
                                    root.set-rate(rate);
                                }
                            }

                            Rectangle {
                                height: 1px;
                                background: #FFFFFF0A;
                            }
                        }
                    }
                }
            }
        }
    }

    tim := Timer {
        // remote walking is slower than a hovering pointer, give it air
        interval: Bridge.touch-mode || Bridge.tv-mode ? 4s : 2s;
        running: true;
        triggered => {
            // The scene condition mirrors main.slint's mount condition: once
            // teardown flips the state this view is on its way out, and a
            // hide fired here would land AFTER the teardown unhide, leaving
            // the cursor invisible at the idle menu for good (Slint's cursor
            // cache never re-applies a value it thinks is current).
            if Bridge.app-state != AppState.Playing
                || Bridge.player-variant != UiPlayerVariant.Video {
                return;
            }
            if !Bridge.is-scrubbing-position
                && (ta.has-hover || !focus.has-focus || show-settings || Bridge.touch-mode) {
                parent.close();
                Bridge.set-cursor-hidden(true);
            }
        }
    }
}

// The mini OSD: what the player says about a transport command that did not
// come from a click on it. One slim strip along the bottom, nothing to press:
// the state, where playback is, a thin line for it, and a word while a seek
// is still landing. The full chrome takes over the moment someone interacts.
component MiniOsd inherits Rectangle {
    in property <bool> shown;

    height: 64px;
    clip: true;

    property <float> played: Bridge.duration-secs > 0
        ? Math.clamp(Bridge.progress-secs / Bridge.duration-secs, 0.0, 1.0)
        : 0.0;
    // A keyboard seek has the badge for how far it went; a sender's is
    // absolute and only says here that it is still landing.
    property <int> delta: Bridge.mini-osd-seek-delta;

    // The same motion as the chrome's reveal: it rises a little and fades,
    // on the controls' own curve.
    body := Rectangle {
        y: root.shown ? 0px : 12px;
        opacity: root.shown ? 1.0 : 0.0;
        animate y, opacity {
            duration: 200ms;
            easing: ease-out-expo;
        }

    Rectangle {
        background: @linear-gradient(0deg, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0.0) 100%);
    }

    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 24px;
        padding-bottom: 16px;
        spacing: 14px;

        VerticalLayout {
            alignment: center;

            Image {
                width: 14px;
                height: 14px;
                source: Bridge.playback-state == GuiPlaybackState.Playing ? Icons.pause : Icons.play;
                colorize: FCastPalette.foreground;
            }
        }

        // Outfit's digits are proportional, so the label is as wide as the
        // widest time it can show (the format is always hh:mm:ss) and left
        // aligned: a ticking digit moves nothing beside it.
        Rectangle {
            width: max(eights.preferred-width, zeros.preferred-width) + 4px;

            // The two widest digit shapes, whichever this face makes wider.
            eights := FText {
                visible: false;
                text: Bridge.is-live ? "88:88:88" : "88:88:88 / 88:88:88";
                font-size: 13px;
            }

            zeros := FText {
                visible: false;
                text: Bridge.is-live ? "00:00:00" : "00:00:00 / 00:00:00";
                font-size: 13px;
            }

            FText {
                x: 0;
                text: Bridge.is-live
                    ? Bridge.sec-float-to-string(Bridge.progress-secs)
                    : Bridge.sec-float-to-string(Bridge.progress-secs) + " / " + Bridge.sec-float-to-string(Bridge.duration-secs);
                font-size: 13px;
                vertical-alignment: center;
                height: 100%;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;

            Rectangle {
                height: 4px;
                border-radius: 2px;
                background: #FFFFFF33;

                Rectangle {
                    x: 0;
                    width: parent.width * root.played;
                    height: parent.height;
                    border-radius: parent.border-radius;
                    background: Bridge.is-live ? FCastPalette.negative-800 : FCastPalette.foreground;
                    animate width { duration: 150ms; }
                }
            }
        }

        if root.delta == 0 && Bridge.seek-pending: FText {
            text: @tr("Seeking…");
            font-size: 13px;
            color: FCastPalette.opacity-light-500;
            vertical-alignment: center;
        }

        // The sender that asked, when it has a name.
        if Bridge.mini-osd-by != "": FText {
            text: Bridge.mini-osd-by;
            font-size: 13px;
            color: FCastPalette.opacity-light-500;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    }
}

// The seek badge: a pill on the side of the picture a keyboard seek went
// toward, with the running total of the presses, the way the video apps show
// a double tap. Pops in, and fades a moment after the last press.
component SeekBadge inherits Rectangle {
    in property <bool> shown;
    // The seconds shown, unsigned: the side and the glyph say which way.
    // Kept by the caller across the fade, so the pill never reads zero on
    // its way out.
    in property <int> seconds;
    in property <bool> rewind;
    // The other side took over: go at once rather than fade.
    in property <bool> snap;

    width: 104px;
    height: 44px;
    border-radius: self.height / 2;
    background: rgba(0, 0, 0, 0.6);
    opacity: root.shown ? 1.0 : 0.0;
    transform-scale: root.shown ? 1.0 : 0.9;
    animate opacity, transform-scale {
        duration: root.shown ? 120ms : (root.snap ? 0ms : 250ms);
        easing: ease-out-expo;
    }

    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        padding-left: 14px;
        padding-right: 14px;

        // Two play glyphs make the fast forward mark, turned round for rewind.
        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 22px;
                height: 12px;
                transform-rotation: root.rewind ? 180deg : 0deg;

                Image {
                    x: 0;
                    width: 12px;
                    height: 12px;
                    source: Icons.play;
                    colorize: FCastPalette.foreground;
                }

                Image {
                    x: 9px;
                    width: 12px;
                    height: 12px;
                    source: Icons.play;
                    colorize: FCastPalette.foreground;
                }
            }
        }

        FText {
            text: @tr("{}s", root.seconds);
            font-size: 15px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component VideoPlayerView inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    // The seek badge's clock: each keyboard seek pops it and restarts the
    // fade, the total it shows is frozen at the last press so the fade-out
    // never reads zero.
    property <bool> badge-visible: false;
    property <int> badge-delta: 0;
    property <int> badge-serial: Bridge.seek-badge-serial;
    changed badge-serial => {
        badge-delta = Bridge.mini-osd-seek-delta;
        badge-visible = true;
        badge-tim.running = true;
        badge-tim.restart();
    }
    badge-tim := Timer {
        interval: 700ms;
        running: false;
        triggered => {
            badge-visible = false;
            Bridge.mini-osd-seek-delta = 0;
            self.running = false;
        }
    }

    // The mini OSD's clock. Every outside transport command shows the strip
    // and restarts the fade; the tick keeps it up while a pause pins it or a
    // seek is still landing, and folds it the first time neither holds.
    property <bool> mini-visible: false;
    property <int> mini-serial: Bridge.mini-osd-serial;
    changed mini-serial => {
        mini-visible = true;
        mini-tim.running = true;
        mini-tim.restart();
    }
    // A pause pinned from outside lets go when playback moves on by any
    // route, a click on the chrome included.
    property <GuiPlaybackState> mini-state: Bridge.playback-state;
    changed mini-state => {
        if mini-state != GuiPlaybackState.Paused {
            Bridge.mini-osd-pinned = false;
        }
    }
    // One source for "the strip is up", so the damper that parks
    // `progress-secs` can see what the strip is reading.
    property <bool> mini-shown: mini-visible && !Bridge.controls-overlay-visible;
    changed mini-shown => {
        Bridge.mini-osd-visible = self.mini-shown;
    }
    mini-tim := Timer {
        interval: 2500ms;
        running: false;
        triggered => {
            if Bridge.mini-osd-pinned || Bridge.seek-pending {
                return;
            }
            mini-visible = false;
            self.running = false;
        }
    }

    // In-window video, behind every control, with black bars around the
    // frame. Desktop always fills: its video is in the window, and gating on
    // the first presented frame showed the gray window background between
    // the loading view and that frame. Android fills only while this path
    // presents, since a fill would cover the surface behind the window.
    if Bridge.sw-video-active || !Bridge.behind-window-video: Rectangle {
        width: 100%;
        height: 100%;
        background: black;
    }
    // Two elements, one clip rect apart, because binding a source-clip at all
    // turns an Image into a clipped one whose rect is taken literally. Only
    // android's zero-copy lane ever needs one (its texture is the whole
    // gralloc allocation, decoder padding included); every other path hands
    // over an image that is already exactly the picture and keeps the plain
    // element it has always had.
    if Bridge.sw-video-clip-width <= 0 || Bridge.sw-video-clip-height <= 0: Image {
        width: 100%;
        height: 100%;
        source: Bridge.sw-video-frame;
        image-fit: contain;
    }
    if Bridge.sw-video-clip-width > 0 && Bridge.sw-video-clip-height > 0: Image {
        width: 100%;
        height: 100%;
        source: Bridge.sw-video-frame;
        image-fit: contain;
        source-clip-x: Bridge.sw-video-clip-x;
        source-clip-y: Bridge.sw-video-clip-y;
        source-clip-width: Bridge.sw-video-clip-width;
        source-clip-height: Bridge.sw-video-clip-height;
    }

    // Subtitle cues above the video, below the controls. The engine lays
    // them out in window coordinates, so anchor to the window origin no
    // matter where this view sits (safe-area offsets move it around).
    for overlay in Bridge.subtitle-overlays: Image {
        source: overlay.img;
        x: overlay.x - root.absolute-position.x;
        y: overlay.y - root.absolute-position.y;
        width: overlay.w;
        height: overlay.h;
    }

    // Bitmap subtitles on the desktop wgpu lane, one image covering the joint
    // bounding box of the active regions, already mapped from video pixels onto
    // the letterboxed picture. Immediately before the cue anchor below, so the
    // z order is inherited rather than argued about: above the video, below the
    // dodvg text cues, below the controls. Same window-origin anchoring as the
    // cue loop above.
    if Bridge.bitmap-subtitle.w > 0px: Image {
        source: Bridge.bitmap-subtitle.img;
        x: Bridge.bitmap-subtitle.x - root.absolute-position.x;
        y: Bridge.bitmap-subtitle.y - root.absolute-position.y;
        width: Bridge.bitmap-subtitle.w;
        height: Bridge.bitmap-subtitle.h;
        // The composite is already the right shape; fill keeps it there rather
        // than re-letterboxing it inside its own rect.
        image-fit: fill;
    }

    // The z order seam for the dodvg scene overlay: the renderer draws the cue
    // display list straight after this rectangle and never paints it, so cues
    // land above the video and below everything below. One physical pixel, and
    // a color no other element uses (Bridge.cue-anchor). On a renderer that
    // does not know the marker it is an invisible pixel in the corner.
    Rectangle {
        x: 0px;
        y: 0px;
        width: 1phx;
        height: 1phx;
        background: Bridge.cue-anchor;
    }

    // Below the chrome, and only while the chrome is away: an interaction
    // that reveals the controls is what retires the strip.
    MiniOsd {
        y: root.height - self.height;
        width: 100%;
        shown: root.mini-shown;
    }

    // One pill per half, on the half the seek went toward. Turning round
    // drops the old one on the spot and starts the other from scratch.
    SeekBadge {
        x: root.width * 0.25 - self.width / 2;
        y: (root.height - self.height) / 2;
        rewind: true;
        shown: badge-visible && badge-delta < 0;
        snap: badge-visible && badge-delta > 0;
        seconds: -badge-delta;
    }

    SeekBadge {
        x: root.width * 0.75 - self.width / 2;
        y: (root.height - self.height) / 2;
        shown: badge-visible && badge-delta > 0;
        snap: badge-visible && badge-delta < 0;
        seconds: badge-delta;
    }

    // Ancestor TouchArea covering the whole view: its has-hover stays true while the pointer is
    // anywhere in the window and drops to false the moment the pointer leaves the window. It
    // forwards events, so the controls underneath keep working. Feeds PlaybackControls so it can
    // hide the overlay on exit.
    window-hover := TouchArea {
        VolumePreview {
            width: 100%;
            height: 100%;
        }

        PlaybackControls {
            width: 100%;
            height: 100%;
            pointer-inside-window: window-hover.has-hover;
        }
    }
}
