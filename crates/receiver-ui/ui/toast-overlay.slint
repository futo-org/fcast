import {
    Icons,
    FText,
} from "../../../ui-components/std-widgets.slint";
import {
    Bridge,
    Assets,
    UiToastKind,
} from "globals.slint";

enum ToastVariant {
    Error,
    Warning,
}

component Toast inherits Rectangle {
    in property <ToastVariant> variant;
    in property <string> message;
    // Stable short code (FC-Exx/FC-Wxx), so a photographed report is
    // matchable whatever the display language.
    in property <string> code;

    background: @linear-gradient(90.17deg, rgba(255, 255, 255, 0.1) 0.15%, rgba(255, 255, 255, 0.03) 85%);
    background-blur: 44px;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: @linear-gradient(153.5deg, rgba(255, 255, 255, 0.1) 7.41%, rgba(255, 255, 255, 0.031) 27.47%, rgba(255, 255, 255, 0.1) 52.75%, rgba(255, 255, 255, 0.03) 73.25%, rgba(255, 255, 255, 0.1) 94.61%);

    HorizontalLayout {
        alignment: center;
        padding: 16px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: t.width;
                height: t.height;

                t := Image {
                    source: Icons.warning-triangle;

                    states [
                        error when variant == ToastVariant.Error: {
                            colorize: @linear-gradient(140.89deg, #F44F5A 15.72%, #EE3D4A 46.23%, #E52030 84.58%);
                        }
                        warning when variant == ToastVariant.Warning: {
                            colorize: @linear-gradient(140.89deg, #fdb022 15.72%, #fdb022 46.23%, #fdb022 84.58%);
                        }
                    ]
                }

                Image {
                    source: Assets.exclamation-mark;
                    width: 35px;
                }
            }
        }

        FText {
            text: message;
            wrap: word-wrap;
            vertical-alignment: center;
        }

        if code != "": FText {
            text: code;
            font-size: 11px;
            color: rgba(255, 255, 255, 0.45);
            vertical-alignment: center;
        }
    }
}

export component ToastOverlay inherits Rectangle  {
    // All user-facing toast wording lives here so it localizes. `detail` is
    // the kind's one interpolable scrap (codec description, host name).
    pure function toast-text(kind: UiToastKind, detail: string) -> string {
        if (kind == UiToastKind.MediaNotFound) {
            return @tr("The media could not be found");
        }
        if (kind == UiToastKind.AccessDenied) {
            return @tr("Access to the media was denied");
        }
        if (kind == UiToastKind.NetworkFailure) {
            if (detail == "") {
                return @tr("Network error while streaming");
            }
            return @tr("Network error while streaming from {}", detail);
        }
        if (kind == UiToastKind.UnsupportedFormat) {
            return @tr("The media format is not supported");
        }
        if (kind == UiToastKind.MissingCodec) {
            return @tr("A codec needed by the media is missing");
        }
        if (kind == UiToastKind.DecodeFailed) {
            return @tr("The media is damaged and could not be decoded");
        }
        if (kind == UiToastKind.DrmProtected) {
            return @tr("The media is DRM protected and cannot be played");
        }
        if (kind == UiToastKind.OutputFailure) {
            return @tr("Audio or video output failed");
        }
        if (kind == UiToastKind.ImageDownloadFailed) {
            return @tr("The image could not be downloaded");
        }
        if (kind == UiToastKind.MissingCodecForTrack) {
            if (detail == "") {
                return @tr("A track was disabled, its codec is missing");
            }
            return @tr("No decoder for {}, the track was disabled", detail);
        }
        if (kind == UiToastKind.StuckStream) {
            return @tr("A stream stopped and will not resume by itself");
        }
        if (kind == UiToastKind.SubtitleFormatUnsupported) {
            return @tr("The subtitle format is not supported");
        }
        return @tr("A playback problem was detected");
    }

    VerticalLayout {
        pure function compute-width(available: length) -> length {
            Math.min(available, error-rect.preferred-width + self.padding * 2)
        }

        width: compute-width(root.width > 700px ? 700px : root.width);
        padding: 20px;

        error-rect := VerticalLayout {
            spacing: 15px;

            if Bridge.is-showing-error-message: HorizontalLayout {
                alignment: center;

                Toast {
                    variant: Error;
                    message: toast-text(Bridge.error-toast-kind, Bridge.error-toast-detail);
                    code: Bridge.error-toast-code;
                }
            }

            if Bridge.is-showing-warning-message: HorizontalLayout {
                alignment: center;

                Toast {
                    variant: Warning;
                    message: toast-text(Bridge.warning-toast-kind, Bridge.warning-toast-detail);
                    code: Bridge.warning-toast-code;
                }
            }
       }

        Rectangle {}
    }

    Timer {
        interval: 4s;
        running: Bridge.is-showing-error-message;
        triggered() => {
            Bridge.is-showing-error-message = false;
        }
    }

    Timer {
        interval: 4s;
        running: Bridge.is-showing-warning-message;
        triggered() => {
            Bridge.is-showing-warning-message = false;
        }
    }
}

