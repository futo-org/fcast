import { Slider, Button, Icons, FText } from "../../../ui-components/std-widgets.slint";
import { Bridge, GuiPlaybackState } from "globals.slint";
import { FCastPalette } from "../../../ui-components/styling.slint";

export component PositionScrubber inherits Slider {
    // No keyboard stepping (value is in seconds, so arrows would nudge by 1s
    // and fight the live progress updates): rejected arrow keys bubble up to
    // the global handler, which does the real 10s seek.
    step: 0;
    hide-thumb: true;
    maximum: Bridge.duration-secs;
    minimum: 0.0;
    value <=> Bridge.progress-secs;
    rail-color: #FFFFFF33;
    buffered-ranges: Bridge.is-live ? [] : Bridge.buffered-ranges;
    buffered-color: #FFFFFF66;
    track-color: Bridge.is-live ? FCastPalette.negative-800 : FCastPalette.foreground;
    thumb-color: black.transparentize(85%);
    thumb-border-color: FCastPalette.foreground;
    enabled: Bridge.playback-state != GuiPlaybackState.Loading;
}

export component ProgressLabelBox inherits Rectangle {
    in property <string> text <=> txt.text;
    // Reveal factor, not `opacity:`. A layered fade hides the backdrop from
    // the frost capture, so tint and blur radius scale with the fade instead.
    in property <float> fade: 1.0;

    background: FCastPalette.opacity-light-1000.transparentize(1 - self.fade);
    background-blur: 27px * self.fade;
    border-radius: 12px;
    height: txt.preferred-height + 4px;
    width: txt.preferred-width + 16px;

    txt := Text {
        color: FCastPalette.foreground;
        font-size: 13px;
        opacity: root.fade;
    }
}

export component ProgressLabels inherits HorizontalLayout {
    in property <float> fade: 1.0;

    padding-left: 10px;
    padding-right: self.padding-left;

    ProgressLabelBox {
        text: Bridge.sec-float-to-string(Bridge.progress-secs);
        fade: root.fade;
    }

    Rectangle {}

    if !Bridge.is-live: ProgressLabelBox {
        text: Bridge.sec-float-to-string(Bridge.duration-secs);
        fade: root.fade;
    }
}

export component ScrubbyMcScrub {
    in property <float> fade: 1.0;

    main-vlayout := VerticalLayout {
        spacing: 8px;

        scrubber := PositionScrubber {
            opacity: root.fade;
            changed(_) => {
                Bridge.is-scrubbing-position = true;
            }

            released(position) => {
                Bridge.is-scrubbing-position = false;
                if position <= Bridge.duration-secs && Bridge.duration-secs != 0.0 {
                    Bridge.seek-pending = true;
                    Bridge.seek-to-percent(position / Bridge.duration-secs);
                }
            }
        }

        ProgressLabels {
            visible: !scrubber.has-hover;
            fade: root.fade;
        }
    }

    Rectangle {
        visible: scrubber.has-hover;
        x: scrubber.mouse-x + main-vlayout.padding - self.width / 2;
        y: scrubber.y + scrubber.height + main-vlayout.spacing;
        width: plb.width;
        height: plb.height;

        plb := ProgressLabelBox {
            text: Bridge.sec-to-string(Bridge.duration-secs * scrubber.mouse-x / scrubber.width);
            fade: root.fade;
        }
    }
}

export component MasterButton inherits Button {
    height: 60px;
    width: 60px;
    icon-size: 20px;
    enabled: false;
    background-default-color: @linear-gradient(133.14deg, rgba(52, 52, 52, 0.6) 6.7%, rgba(20, 20, 20, 0.6) 92.77%);
    background-blur: 41px;

    states [
        playing when Bridge.playback-state == GuiPlaybackState.Playing: {
            icon: Icons.pause;
            enabled: true;
        }
        paused when Bridge.playback-state == GuiPlaybackState.Paused: {
            icon: Icons.play;
            enabled: true;
        }
    ]

    clicked => {
        Bridge.resume-or-pause();
    }
}

export component VolumePreview {
    property <bool> shown: Bridge.volume-set-at > 0;
    // A single animated factor drives the slide and the fade together, so a
    // window resize never animates. Swap the easing to taste: `ease-out-expo`
    // for a snappier settle, `ease-in-out` for symmetric, `ease-in-expo` for a
    // slow-then-accelerating entrance.
    property <float> reveal: root.shown ? 1.0 : 0.0;
    animate reveal {
        duration: 250ms;
        easing: ease-out;
    }

    // Tell the Wayland subsurface sink to keep the video below the GUI for as
    // long as any part of the overlay is on screen, i.e. through the whole
    // slide/fade animation and not just while `volume-set-at > 0`.
    init => {
        Bridge.volume-overlay-shown = root.reveal > 0.01;
    }
    changed reveal => {
        Bridge.volume-overlay-shown = root.reveal > 0.01;
    }

    pill := Rectangle {
        border-radius: self.width / 2;
        // Faded via color alpha and blur radius, not `opacity:`. A layered
        // fade hides the backdrop from the frost capture mid-animation.
        background: #00000080.transparentize(1 - root.reveal);
        background-blur: 44px * root.reveal;
        height: root.height * 40%;
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.18).transparentize(1 - root.reveal);
        width: bar.preferred-width + 26px * 2;

        // Right side, vertically centred. Slides in from off the right edge:
        // reveal = 1 rests 45px from the edge, reveal = 0 sits fully off-screen.
        y: (root.height - self.height) / 2;
        x: root.width - (self.width + 45px) * root.reveal;
        visible: root.reveal > 0.01;

        vl := VerticalLayout {
            padding-top: 10px;
            padding-bottom: 10px;
            alignment: space-between;
            opacity: root.reveal;

            bar := Slider {
                // Display-only: keep arrow keys bubbling to the global
                // volume handler instead of nudging a value nothing reads.
                step: 0;
                maximum: 1.0;
                minimum: 0.0;
                value: Bridge.volume;
                height: parent.height - icon-rect.height - 15px;
                orientation: vertical;
                rail-color: #FFFFFF33;
                hide-thumb: true;
            }

            icon-rect := Rectangle {
                width: parent.width;
                height: vol-img.height + 15px;

                vol-img := Image {
                    colorize: FCastPalette.neutral-100;
                    width: 25px;
                    height: 23px;
                    x: parent.width / 2 - self.width / 2;
                    y: parent.height / 2 - self.height / 2;

                    states [
                        high when Bridge.volume > 50%: {
                            source: Icons.volume-high;
                        }
                        muted when Bridge.volume == 0%: {
                            source: Icons.volume-muted;
                        }
                        low when Bridge.volume < 50%: {
                            source: Icons.volume-low;
                        }
                    ]
                }
            }
        }
    }

    // The indicator stays visible while `volume-set-at` counts down to 0.
    // 5 ticks * 350ms = 1750ms visible (Rust resets it to 1.0 on each change).
    Timer {
        running: Bridge.volume-set-at > 0;
        interval: 350ms;

        triggered => {
            Bridge.volume-set-at -= 0.2;
        }
    }
}

