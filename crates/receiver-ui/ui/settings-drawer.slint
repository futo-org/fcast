import {
    Switch,
    LineEdit,
    Button,
    ScrollView,
    Icons,
} from "../../../ui-components/std-widgets.slint";
import { FCastPalette, RowTint, Icons as FluentIcons } from "../../../ui-components/styling.slint";
import { Bridge } from "globals.slint";

// A section heading (icon + label) that groups related settings.
component SectionHeader inherits HorizontalLayout {
    in property <string> title;
    in property <image> icon;

    spacing: 8px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 18px;
    padding-bottom: 6px;

    VerticalLayout {
        alignment: center;

        Image {
            source: root.icon;
            width: 15px;
            height: 15px;
            colorize: FCastPalette.opacity-light-500;
        }
    }

    Text {
        text: root.title;
        color: FCastPalette.opacity-light-500;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
    }

    Rectangle { }
}

// The drawer's list scrolls to whichever row takes focus, since a remote has
// no wheel. Rows report themselves in window coordinates; the drawer keeps
// the scroll view's frame here and moves the viewport.
global SettingsScroll {
    // Two-way with the scroll view's viewport.
    in-out property <length> viewport-y;
    // The visible frame, in window coordinates, kept by the drawer.
    in-out property <length> top;
    in-out property <length> visible-height;

    // Bring a row into view with a section header's worth of room above it,
    // so the first row of a section shows its title and the first row of the
    // list scrolls the list all the way back up.
    public function reveal(row-top: length, row-height: length) {
        // No frame yet means nothing to reveal against.
        if self.visible-height <= 0px {
            return;
        }
        if row-top - self.top < 44px {
            self.viewport-y = min(0px, self.viewport-y + (44px - (row-top - self.top)));
        } else if row-top - self.top + row-height + 8px > self.visible-height {
            self.viewport-y = self.viewport-y - (row-top - self.top + row-height + 8px - self.visible-height);
        }
    }
}

// A tap anywhere but a text field ends its edit. Rows take no focus on a
// tap and the scroll view grabs the press, so no focus change would.
global SettingsEdit {
    in-out property <int> folds;

    public function fold() {
        self.folds += 1;
    }
}

// A boolean setting: label on the left, a Switch on the right. Toggling
// autosaves through `set-bool-setting`. The switch is the tab stop; the whole
// row tints while it holds focus, and a click anywhere on the row toggles.
component ToggleRow inherits Rectangle {
    in property <string> label;
    in property <string> setting-key;
    in-out property <bool> value;

    background: sw.has-focus ? RowTint.focused : (touch.has-hover ? RowTint.hovered : transparent);
    animate background { duration: 100ms; }

    function toggle() {
        root.value = !root.value;
        Bridge.set-bool-setting(root.setting-key, root.value);
    }

    touch := TouchArea {
        clicked => {
            SettingsEdit.fold();
            root.toggle();
        }
    }

    HorizontalLayout {
        spacing: 12px;
        padding-left: 24px;
        padding-right: 20px;
        padding-top: 7px;
        padding-bottom: 7px;

        Text {
            text: root.label;
            color: FCastPalette.foreground;
            font-size: 14px;
            horizontal-stretch: 1;
            vertical-alignment: center;
            wrap: word-wrap;
        }

        VerticalLayout {
            alignment: center;

            sw := Switch {
                focus-ring: false;
                checked <=> root.value;
                toggled => {
                    SettingsEdit.fold();
                    Bridge.set-bool-setting(root.setting-key, self.checked);
                }
                changed has-focus => {
                    if self.has-focus {
                        SettingsScroll.reveal(root.absolute-position.y, root.height);
                    }
                }
            }
        }
    }
}

// android: the overlay grant, which the system holds rather than the config.
// The switch mirrors it, a toggle opens the system page and the switch snaps
// back until the grant itself changes. Disabled where no such page exists.
component OverlayPermissionRow inherits Rectangle {
    in property <string> label;
    property <bool> granted: Bridge.overlay-permission;
    changed granted => {
        sw.checked = self.granted;
    }

    background: sw.has-focus ? RowTint.focused : (touch.has-hover ? RowTint.hovered : transparent);
    animate background { duration: 100ms; }

    function open() {
        sw.checked = root.granted;
        if Bridge.overlay-permission-settings {
            Bridge.open-overlay-settings();
        }
    }

    touch := TouchArea {
        clicked => {
            SettingsEdit.fold();
            root.open();
        }
    }

    HorizontalLayout {
        spacing: 12px;
        padding-left: 24px;
        padding-right: 20px;
        padding-top: 7px;
        padding-bottom: 7px;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.label;
                color: FCastPalette.foreground;
                font-size: 14px;
                wrap: word-wrap;
            }

            if !root.granted: Text {
                text: Bridge.overlay-permission-settings
                    ? @tr("Needs permission to display over other apps")
                    : @tr("Not available on this device");
                color: FCastPalette.opacity-light-500;
                font-size: 11px;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;

            sw := Switch {
                focus-ring: false;
                enabled: Bridge.overlay-permission-settings;
                checked: root.granted;
                toggled => {
                    SettingsEdit.fold();
                    root.open();
                }
                changed has-focus => {
                    if self.has-focus {
                        SettingsScroll.reveal(root.absolute-position.y, root.height);
                    }
                }
            }
        }
    }
}

// A free-text setting. Autosaves on Enter or when focus leaves the field, so a
// half-typed value is never written.
//
// The row, not the field, is the tab stop: browsing the list with a remote
// lands on the row and shows the value, and only selecting it (Enter, or a
// click) brings the field up and focuses it, which is what opens the on-screen
// keyboard. The field is invisible while not editing, so tab traversal can
// never reach it on its own. Enter, Escape, Back, the soft keyboard being
// dismissed, or focus leaving the field saves and hands focus back to the row.
component TextRow inherits Rectangle {
    in property <string> label;
    in property <string> setting-key;
    in property <string> placeholder;
    in-out property <string> value;
    property <bool> editing: false;
    // On android the soft keyboard going away leaves the field. Mirrored
    // here because `changed` watches an element's own properties.
    property <bool> keyboard: Bridge.soft-keyboard-visible;
    property <int> folds: SettingsEdit.folds;

    background: row-focus.has-focus || root.editing
        ? RowTint.focused
        : (touch.has-hover ? RowTint.hovered : transparent);
    animate background { duration: 100ms; }

    // Focus by name once the field is visible: a focus() from a conditional
    // element's init is not reliable, and a field left in edit mode with
    // no focus shows no keyboard and answers no key.
    function begin-edit() {
        root.editing = true;
        field.focus();
    }

    changed keyboard => {
        if (!root.keyboard && root.editing) {
            root.end-edit();
        }
    }

    // A tap elsewhere ends the edit. With a keyboard or remote focus goes to
    // the row: focus on nothing lets Escape and Tab out of the drawer's trap.
    // On touch it just clears, a focused row would stay tinted after the tap.
    changed folds => {
        if root.editing {
            if Bridge.touch-mode {
                // losing focus saves and folds, see the field's has-focus
                field.clear-focus();
            } else {
                root.end-edit();
            }
        }
    }

    function end-edit() {
        // Cleared by hand too: the flag the window keys its arrow capture on
        // must be down before focus moves to the row.
        Bridge.text-edit-focused = false;
        root.editing = false;
        row-focus.focus();
        // Saved after the focus move: leaving the field commits the soft
        // keyboard's composing word into it, Enter alone does not.
        Bridge.set-string-setting(root.setting-key, field.text);
    }

    touch := TouchArea {
        clicked => {
            root.begin-edit();
        }
    }

    // Zero width, so it never takes clicks away from the touch area.
    row-focus := FocusScope {
        x: 0;
        width: 0;

        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.begin-edit();
                return accept;
            }

            return reject;
        }
        changed has-focus => {
            if self.has-focus {
                SettingsScroll.reveal(root.absolute-position.y, root.height);
            }
        }
    }

    HorizontalLayout {
        spacing: 12px;
        padding-left: 24px;
        padding-right: 20px;
        padding-top: 7px;
        padding-bottom: 7px;

        Text {
            text: root.label;
            color: FCastPalette.foreground;
            font-size: 14px;
            horizontal-stretch: 1;
            vertical-alignment: center;
            wrap: word-wrap;
        }

        VerticalLayout {
            alignment: center;

            // One slot for both faces of the value: an invisible element
            // still takes its place in a layout, so they overlap here.
            Rectangle {
                width: 190px;
                height: 32px;

                // The value at rest: the field's footprint, none of its focus.
                Rectangle {
                    visible: !root.editing;
                    border-radius: 4px;
                    background: FCastPalette.opacity-light-1100;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;

                        Text {
                            text: root.value == "" ? root.placeholder : root.value;
                            color: root.value == "" ? FCastPalette.opacity-light-500 : FCastPalette.foreground;
                            font-size: 14px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

            field := LineEdit {
                visible: root.editing;
                width: parent.width;
                height: parent.height;
                text <=> root.value;
                placeholder-text: root.placeholder;
                accepted => {
                    root.end-edit();
                }
                // Back on a remote leaves the field like Escape does. On
                // android the first Back only hides the keyboard, the second
                // reaches here; unhandled it would close the whole drawer.
                key-pressed(event) => {
                    if event.text == Key.Escape || event.text == Key.Back {
                        root.end-edit();
                        return accept;
                    }

                    return reject;
                }
                changed has-focus => {
                    Bridge.text-edit-focused = self.has-focus;
                    if !self.has-focus && root.editing {
                        // Focus moved on by itself (a click elsewhere, the
                        // remote stepping past): save and fold, but leave
                        // focus where it went.
                        Bridge.set-string-setting(root.setting-key, self.text);
                        root.editing = false;
                    }
                }
            }
            }
        }
    }
}

// A one-of setting as an inline spinner, the way TV settings do it: the row
// shows the value between two chevrons, Left and Right step through the
// options with wrap-around, Enter steps forward, and every step autosaves.
// Nothing opens: one row, no second step, no focus to catch on the way out.
// The first model entry is the one an unset config resolves to, spelled
// either as the sentinel "Default" or as the value it means.
component SelectRow inherits Rectangle {
    in property <string> label;
    in property <string> setting-key;
    in property <[string]> model;
    in-out property <string> value;
    // The value's place in the model, kept by the probes below, since a
    // function cannot search an array.
    property <int> current: 0;
    property <bool> lit: row-focus.has-focus || touch.has-hover || prev-touch.has-hover || next-touch.has-hover;

    background: row-focus.has-focus ? RowTint.focused : (root.lit ? RowTint.hovered : transparent);
    animate background { duration: 100ms; }

    function step(delta: int) {
        if root.model.length == 0 {
            return;
        }
        root.current = Math.mod(root.current + delta + root.model.length, root.model.length);
        root.value = root.model[root.current];
        Bridge.set-string-setting(root.setting-key, root.value);
    }

    // One zero-size probe per option: whichever matches the value names the
    // current index, at creation and whenever the value moves under it.
    for opt[i] in root.model: Rectangle {
        width: 0;
        height: 0;
        property <bool> hit: opt == root.value;
        init => {
            if self.hit {
                root.current = i;
            }
        }
        changed hit => {
            if self.hit {
                root.current = i;
            }
        }
    }

    touch := TouchArea {
        clicked => {
            SettingsEdit.fold();
            root.step(1);
        }
    }

    // Zero width, so it never takes clicks away from the touch areas.
    row-focus := FocusScope {
        x: 0;
        width: 0;

        key-pressed(event) => {
            if event.text == Key.RightArrow || event.text == Key.Return || event.text == Key.Space {
                root.step(1);
                return accept;
            }
            if event.text == Key.LeftArrow {
                root.step(-1);
                return accept;
            }

            return reject;
        }
        changed has-focus => {
            if self.has-focus {
                SettingsScroll.reveal(root.absolute-position.y, root.height);
            }
        }
    }

    HorizontalLayout {
        spacing: 10px;
        padding-left: 24px;
        padding-right: 20px;
        padding-top: 7px;
        padding-bottom: 7px;

        Text {
            text: root.label;
            color: FCastPalette.foreground;
            font-size: 14px;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }

        // The chevrons brighten with the row, so the affordance reads from
        // the couch.
        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 4px;
                background: prev-touch.has-hover ? RowTint.focused : transparent;

                Image {
                    source: FluentIcons.chevron-down;
                    width: 12px;
                    transform-rotation: 90deg;
                    colorize: root.lit ? FCastPalette.foreground : FCastPalette.opacity-light-500;
                }

                prev-touch := TouchArea {
                    clicked => {
                        SettingsEdit.fold();
                        root.step(-1);
                    }
                }
            }
        }

        Text {
            text: root.value;
            color: root.lit ? FCastPalette.foreground : FCastPalette.opacity-light-500;
            font-size: 14px;
            min-width: 96px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 4px;
                background: next-touch.has-hover ? RowTint.focused : transparent;

                Image {
                    source: FluentIcons.chevron-down;
                    width: 12px;
                    transform-rotation: -90deg;
                    colorize: root.lit ? FCastPalette.foreground : FCastPalette.opacity-light-500;
                }

                next-touch := TouchArea {
                    clicked => {
                        SettingsEdit.fold();
                        root.step(1);
                    }
                }
            }
        }
    }
}

// A drawer that slides in from the right over a dimmed scrim. Reachable from the
// idle screen's gear button (`Bridge.show-settings`).
//
// Only the panel animates (it slides via the `reveal` factor). The scrim does
// not fade, and because the slide is driven by `reveal` rather than an animated
// `x`, resizing the window repositions the panel instantly instead of animating.
export component SettingsDrawer inherits Rectangle {
    property <bool> open: Bridge.show-settings;
    property <float> reveal: root.open ? 1.0 : 0.0;

    // Opening hands the keyboard to the panel: from there the guards below keep
    // tab traversal inside it, and main.slint takes focus back on close. On TV
    // the close button takes it, so the remote has something to act on. On
    // desktop and phones the head guard holds it instead: invisible, no ring
    // for a pointer or touch user, and the first Tab lands on the close button
    // all the same.
    changed open => {
        if root.open {
            if Bridge.tv-mode {
                close-btn.focus();
            } else {
                head-guard.focus();
            }
        }
    }

    // A single animated factor drives everything: the panel slide and the scrim
    // fade both follow `reveal`, and nothing else animates (so resizing the
    // window repositions the panel instantly). The duration matches the video
    // player settings drawer.
    animate reveal {
        duration: 100ms;
    }

    // `open` is in there so the panel is already drawn on the frame that gets the
    // focus, before the reveal animation has ticked once.
    visible: root.open || root.reveal > 0.0;

    // Dimmed background tint. Its opacity fades with `reveal`. The panel itself
    // only slides, it does not fade.
    Rectangle {
        background: #000000.transparentize(0.45);
        opacity: root.reveal;

        // Clicking the dimmed area closes the drawer.
        TouchArea {
            enabled: root.open;
            clicked => {
                Bridge.show-settings = false;
            }
        }
    }

    panel := Rectangle {
        width: min(440px, parent.width * 0.9);
        height: parent.height;
        x: parent.width - self.width * root.reveal;
        background: @linear-gradient(180deg, #101010 0%, #0F0F10 100%);

        // Tab traversal knows nothing about modal layers, so two guards fence the
        // panel in: whichever one traversal lands on hands focus straight back to
        // the close button, which keeps the idle screen behind the scrim out of
        // reach. They bracket the panel's children, so they must stay first and
        // last here. Forward tab wraps to the top of the panel; backward tab stops
        // at the close button rather than wrapping to the bottom.
        head-guard := FocusScope {
            width: 0;
            height: 0;

            focus-gained(reason) => {
                if reason == FocusReason.tab-navigation {
                    close-btn.focus();
                }
            }
        }

        // Left edge divider.
        Rectangle {
            x: 0;
            width: 1px;
            background: FCastPalette.opacity-light-1000;
        }

        // Absorb clicks inside the panel so they don't reach the scrim.
        TouchArea {
            clicked => {
                SettingsEdit.fold();
            }
        }

        // The panel runs under the system bars, its content stays inside them.
        VerticalLayout {
            padding-right: Bridge.safe-area-right;

            HorizontalLayout {
                padding: 20px;
                padding-top: 20px + Bridge.safe-area-top;
                padding-bottom: 12px;
                spacing: 12px;

                Text {
                    text: @tr("Settings");
                    color: FCastPalette.foreground;
                    font-size: 20px;
                    font-weight: 600;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }

                // Focus is the widget's ring, like every other button.
                Rectangle {
                    width: 34px;
                    height: 34px;

                    close-btn := Button {
                        width: parent.width;
                        height: parent.height;
                        icon: Icons.close;
                        icon-size: 13px;
                        clicked => {
                            Bridge.show-settings = false;
                        }
                    }
                }
            }

            scroll := ScrollView {
                vertical-stretch: 1;
                viewport-y <=> SettingsScroll.viewport-y;
                // The frame the rows are revealed against. Set at creation
                // and again whenever the layout gives the view a new height:
                // a `changed` alone never fires for a first value.
                init => {
                    SettingsScroll.visible-height = self.visible-height;
                    SettingsScroll.top = self.absolute-position.y;
                }
                changed visible-height => {
                    SettingsScroll.visible-height = self.visible-height;
                    SettingsScroll.top = self.absolute-position.y;
                }

                // Taps between the rows land here, the flickable keeps them
                // from the panel's area behind it. Not a layout, so it
                // leaves the content height to the rows.
                TouchArea {
                    clicked => {
                        SettingsEdit.fold();
                    }
                }

                VerticalLayout {
                    padding-bottom: 16px;

                    SectionHeader {
                        title: @tr("FCast");
                        icon: Icons.fcast-small;
                    }
                    ToggleRow {
                        label: @tr("Enabled");
                        setting-key: "fcast.enabled";
                        value <=> Bridge.cfg-fcast-enabled;
                    }
                    TextRow {
                        label: @tr("Name");
                        setting-key: "fcast.name";
                        placeholder: "FCast-{hostname}";
                        value <=> Bridge.cfg-fcast-name;
                    }

                    SectionHeader {
                        title: @tr("AirPlay audio");
                        icon: Icons.audio;
                    }
                    ToggleRow {
                        label: @tr("Enabled");
                        setting-key: "raop.enabled";
                        value <=> Bridge.cfg-raop-enabled;
                    }
                    TextRow {
                        label: @tr("Name");
                        setting-key: "raop.name";
                        placeholder: "FCast-{hostname}";
                        value <=> Bridge.cfg-raop-name;
                    }

                    // android runs no Google Cast server, its activity
                    // registers no _googlecast record
                    if !Bridge.android: SectionHeader {
                        title: @tr("Google Cast");
                        icon: Icons.gcast-small;
                    }
                    if !Bridge.android: ToggleRow {
                        label: @tr("Enabled");
                        setting-key: "chromecast.enabled";
                        value <=> Bridge.cfg-chromecast-enabled;
                    }
                    if !Bridge.android: TextRow {
                        label: @tr("Name");
                        setting-key: "chromecast.name";
                        placeholder: "Chromecast-{hostname}";
                        value <=> Bridge.cfg-chromecast-name;
                    }

                    if Bridge.settings-airplay-available: SectionHeader {
                        title: @tr("AirPlay mirroring");
                        icon: Icons.mirror;
                    }
                    if Bridge.settings-airplay-available: ToggleRow {
                        label: @tr("Enabled");
                        setting-key: "airplay.enabled";
                        value <=> Bridge.cfg-airplay-enabled;
                    }

                    SectionHeader {
                        title: @tr("Interface");
                        icon: Icons.tv-outline;
                    }
                    if Bridge.android: OverlayPermissionRow {
                        label: @tr("Open casts automatically");
                    }
                    // applies at once: the receiver keeps running in the
                    // background and starts with the device
                    if Bridge.android: ToggleRow {
                        label: @tr("Start on boot");
                        setting-key: "interface.start_on_boot";
                        value <=> Bridge.cfg-interface-start-on-boot;
                    }
                    // Window management is a desktop concept: no tray, no
                    // start-fullscreen, no headless on android, and its
                    // fullscreen player is hardwired on rather than a
                    // setting.
                    if !Bridge.android: ToggleRow {
                        label: @tr("Show window on start");
                        setting-key: "interface.show_window";
                        value <=> Bridge.cfg-interface-show-window;
                    }
                    // no tray on touch platforms either
                    if !Bridge.touch-mode && !Bridge.android: ToggleRow {
                        label: @tr("System tray icon");
                        setting-key: "interface.tray";
                        value <=> Bridge.cfg-interface-tray;
                    }
                    if !Bridge.android: ToggleRow {
                        label: @tr("Start fullscreen");
                        setting-key: "interface.start_fullscreen";
                        value <=> Bridge.cfg-interface-start-fullscreen;
                    }
                    if !Bridge.android: ToggleRow {
                        label: @tr("Fullscreen player");
                        setting-key: "interface.fullscreen_player";
                        value <=> Bridge.cfg-interface-fullscreen-player;
                    }
                    if !Bridge.android: ToggleRow {
                        label: @tr("Headless (no window)");
                        setting-key: "interface.headless";
                        value <=> Bridge.cfg-interface-headless;
                    }
                    // "tv" is the 10-foot layout and the default. "auto" gives
                    // that only on TV-sized panels, "desktop" never. A literal
                    // factor is config-file only, not dropdown material. android
                    // keeps the system density, nothing installs a scaler.
                    if !Bridge.android: SelectRow {
                        label: @tr("UI size");
                        setting-key: "interface.ui_scale";
                        model: ["tv", "auto", "desktop"];
                        value <=> Bridge.cfg-interface-ui-scale;
                    }

                    // Render profiles and interface excludes steer the desktop
                    // video lane and mdns daemon, android has neither.
                    if !Bridge.android: SectionHeader {
                        title: @tr("Video");
                        icon: Icons.settings-video;
                    }
                    if !Bridge.android: SelectRow {
                        label: @tr("Render profile");
                        setting-key: "video.render_profile";
                        model: ["Default", "fast", "balanced", "high-quality"];
                        value <=> Bridge.cfg-video-render-profile;
                    }

                    if !Bridge.android: SectionHeader {
                        title: @tr("Network");
                        icon: Icons.network;
                    }
                    if !Bridge.android: TextRow {
                        label: @tr("Exclude interfaces (regex)");
                        setting-key: "discovery.exclude_interfaces";
                        placeholder: @tr("none");
                        value <=> Bridge.cfg-discovery-exclude-interfaces;
                    }

                    SectionHeader {
                        title: @tr("Logging");
                        icon: Icons.dev-log;
                    }
                    SelectRow {
                        label: @tr("Log level");
                        setting-key: "log.level";
                        model: ["Default", "off", "error", "warn", "info", "debug", "trace"];
                        value <=> Bridge.cfg-log-level;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: FCastPalette.opacity-light-1000;
            }

            VerticalLayout {
                padding: 16px;
                padding-bottom: 16px + Bridge.safe-area-bottom;
                spacing: 5px;

                Text {
                    text: @tr("Changes save automatically and take effect after you restart the receiver.");
                    color: FCastPalette.opacity-light-500;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                if Bridge.settings-config-path != "": Text {
                    text: Bridge.settings-config-path;
                    color: FCastPalette.opacity-light-700;
                    font-size: 10px;
                    wrap: word-wrap;
                }
            }
        }

        // Second half of the guard pair declared at the top of the panel.
        tail-guard := FocusScope {
            width: 0;
            height: 0;

            focus-gained(reason) => {
                if reason == FocusReason.tab-navigation {
                    close-btn.focus();
                }
            }
        }
    }
}
