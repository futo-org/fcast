import { UiBufferedRange } from "../../../ui-components/std-widgets.slint";

export { UiBufferedRange }

export enum GuiPlaybackState {
    Idle,
    Playing,
    Paused,
    Loading,
}

export enum AppState {
    Idle,
    LoadingMedia,
    Playing,
}

export enum UiPlayerVariant {
    Unknown,
    Image,
    Audio,
    Video,
    Raop,
}

export struct UiStreamDbg {
    id: string,
    codec: string,
}

export enum UiMediaTrackType {
    Video,
    Audio,
    Subtitle,
}

export struct UiMediaTrack {
    id: int,
    name: string,
}

export struct CompoundImage {
    img: image,
    rotation: angle,
}

export enum UiMode {
    Minimal,
    Full,
}

export enum UiUpdaterState {
    None,
    ShowingDialog,
    Downloading,
    DownloadFailed,
    InstallFailed,
    InstallSuccessful,
}

export struct UiVideoDbgInfo {
    format: string,
    resolution: string,
    framerate: string,
    pixel-aspect: string,
    rotation: string,
    memory: string,
    primaries: string,
    transfer: string,
    matrix: string,
    range: string,
    hdr: string,
}

export global Bridge {
    in property <float> progress-secs;
    in property <float> duration-secs;
    // Buffered regions of the current media, as fractions [0.0, 1.0] of the timeline (see
    // `Player::buffered_ranges`). Drawn on the scrubber.
    in property <[UiBufferedRange]> buffered-ranges;
    in property <AppState> app-state: AppState.Idle;
    in property <bool> is-live: false;
    in property <string> media-title;
    in property <string> artist-name;
    in property <bool> is-fullscreen;
    in property <image> qr-code;
    in property <CompoundImage> image-preview;
    in property <CompoundImage> audio-track-cover;
    in property <CompoundImage> blured-audio-track-cover;
    in property <string> local-ip-addrs;
    in property <string> device-name;
    in property <[UiMediaTrack]> video-tracks;
    in property <[UiMediaTrack]> audio-tracks;
    in property <[UiMediaTrack]> subtitle-tracks;
    in property <int> current-video-track;
    in property <int> current-audio-track;
    in property <int> current-subtitle-track;
    in property <string> error-message;
    in property <string> warning-message;
    in property <int> playlist-idx;
    in property <int> playlist-length;
    in property <UiMode> ui-mode: UiMode.Full;
    in property <int> update-download-progress;
    in property <string> updater-error-msg;
    // True when the current image is decoded through the player pipeline
    // (fimagedec) rather than the legacy in-GUI decoder. The image view paints
    // nothing opaque so the video sink below shows through.
    in property <bool> image-via-player: false;
    in property <int> video-frame-width;
    in property <int> video-frame-height;
    // Server-directed source backoff countdown ("server busy, retrying in
    // Ns"). remaining == 0 means none; total sizes the drain bar.
    in property <int> source-backoff-remaining-ms: 0;
    in property <int> source-backoff-total-ms: 0;
    // True from launch until the FCast port is committed. Drives the startup
    // screen (spinner / port-conflict prompt) shown over the idle background.
    in property <bool> starting-up: true;
    // While starting up, true if the port is taken and we're prompting the user.
    in property <bool> show-port-conflict: false;
    in property <int> conflicting-port: 0;

    in-out property <GuiPlaybackState> playback-state: GuiPlaybackState.Idle;
    in-out property <float> volume: 1.0;
    in-out property <bool> is-debugging: false;
    in-out property <int> connected_devices: 0;
    in-out property <bool> is-scrubbing-position: false;
    // True from the moment the user releases the scrubber until the pipeline reports it has landed
    // on the requested position.
    in-out property <bool> seek-pending: false;
    in-out property <UiPlayerVariant> player-variant: UiPlayerVariant.Unknown;
    in-out property <float> playback-rate: 1.0;
    in-out property <bool> is-showing-error-message: false;
    in-out property <bool> is-showing-warning-message: false;
    in-out property <float> volume-set-at: 0.0;
    // True while the volume overlay is on screen, including its slide/fade-out tail (maintained by
    // VolumePreview from its animation).
    in-out property <bool> volume-overlay-shown: false;
    in-out property <UiUpdaterState> updater-state: UiUpdaterState.None;
    // Maintained by the video player's PlaybackControls: true while the controls are drawn over the video.
    in-out property <bool> controls-overlay-visible: false;

    // Inspector
    in-out property <bool> show-inspector: false;
    in property <bool> have-video-dbg-info: false;
    in property <UiVideoDbgInfo> video-dbg-info;
    // Measured video render cost + applied render-delay, set by the render
    // path (see `note_render_cost`).
    in property <string> render-latency-info;

    // Bumped by every tab press that no widget consumed, i.e. every one that
    // moves the keyboard focus. Views with auto-hiding chrome watch it to stay
    // awake while the keyboard walks them.
    in-out property <int> tab-nav-serial: 0;

    // Settings drawer. `show-settings` toggles the slide-in panel. The `cfg-*`
    // properties mirror the persisted config, seeded once at startup by
    // `InitSettings` and two-way bound to the drawer's controls, which autosave
    // through `set-bool-setting` / `set-string-setting`.
    in-out property <bool> show-settings: false;
    in property <string> settings-config-path;
    in property <bool> settings-airplay-available: true;
    in-out property <bool> cfg-fcast-enabled: true;
    in-out property <string> cfg-fcast-name;
    in-out property <bool> cfg-raop-enabled: true;
    in-out property <string> cfg-raop-name;
    // Placeholder until the first config push; matches ChromecastConfig's default.
    in-out property <bool> cfg-chromecast-enabled: false;
    in-out property <string> cfg-chromecast-name;
    in-out property <bool> cfg-airplay-enabled: true;
    in-out property <bool> cfg-interface-show-window: true;
    in-out property <bool> cfg-interface-tray: true;
    in-out property <bool> cfg-interface-start-fullscreen: false;
    in-out property <bool> cfg-interface-fullscreen-player: true;
    in-out property <bool> cfg-interface-headless: false;
    // Seeded with what an unset config means, so the startup push is a no-op
    // and the `changed` hook in main.slint only fires on a real difference.
    in-out property <string> cfg-interface-ui-scale: "tv";
    in-out property <bool> cfg-video-hdr-output: true;
    in-out property <string> cfg-video-render-profile: "Default";
    in-out property <string> cfg-discovery-exclude-interfaces;
    in-out property <string> cfg-log-level: "Default";

    out property <brush> controls-bg-gradient: @linear-gradient(0deg, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0.2) 50%, rgba(0, 0, 0, 0.60) 100%, rgba(0, 0, 0, 0));
    // Whether any GUI element is (potentially) drawn over the video area.
    out property <bool> video-obstructed:
        app-state != AppState.Playing
        || player-variant != UiPlayerVariant.Video
        || playback-state != GuiPlaybackState.Playing
        || controls-overlay-visible
        || source-backoff-remaining-ms > 0
        || should-show-toast-overlay()
        || show-inspector
        || starting-up
        || volume-set-at > 0
        || volume-overlay-shown;

    callback resume-or-pause();
    callback seek-to-percent(float);
    callback toggle-fullscreen();
    callback set-volume(float);
    callback force-quit();
    // Port-conflict dialog actions.
    callback port-conflict-retry();
    callback port-conflict-use-different-port();
    callback port-conflict-quit();
    callback debug-toggled();
    callback change-playback-rate(rate: float);
    callback set-cursor-hidden(hidden: bool);
    callback select-track(id: int, variant: UiMediaTrackType);
    callback select-playlist-item(idx: int);
    callback perform-app-update();
    callback restart-app();
    callback video-obstructed-changed(obstructed: bool);
    // Fired whenever the window's logical size changes, including after our own
    // rescale. Drives the scale-factor policy (see receiver-ui's `scaling`).
    callback window-geometry-changed();
    // A new `[interface] ui_scale`, applied to the live window.
    callback ui-scale-changed(mode: string);
    callback new-video-frame();
    callback stop-playback();

    // Inspector
    callback inspector-toggled(active: bool);
    callback refresh-pipeline-graph();
    // Fired periodically while the inspector is open, drives the bitrate
    // sampling (the receiver polls the player and pushes a fresh graph).
    callback inspector-tick();

    // Settings drawer autosave. `key` is a dotted `section.key` (see
    // `Config::set_bool` / `Config::set_string`). A bool fires on toggle, a
    // string on Enter or focus-out (or dropdown selection).
    callback set-bool-setting(key: string, value: bool);
    callback set-string-setting(key: string, value: string);

    pure callback sec-to-string(sec: int) -> string;
    pure callback sec-float-to-string(sec: float) -> string;

    public pure function should-show-toast-overlay() -> bool {
        is-showing-error-message || is-showing-warning-message
    }

    public pure function gui-playback-state-to-string(pbstate: GuiPlaybackState) -> string {
        if (pbstate == GuiPlaybackState.Idle) {
            return "Idle";
        }
        if (pbstate == GuiPlaybackState.Playing) {
            return "Playing";
        }
        if (pbstate == GuiPlaybackState.Paused) {
            return "Paused";
        }
        if (pbstate == GuiPlaybackState.Loading) {
            return "Loading";
        }
        return "Invalid";
    }

    public pure function is-playing() -> bool {
        playback-state != GuiPlaybackState.Idle && playback-state != GuiPlaybackState.Loading
    }

    public function toggle-debug-mode() {
        is-debugging = !is-debugging;
        debug-toggled();
    }

    public function device-disconnected() {
        connected_devices = max(connected_devices - 1, 0);
    }

    // Global shortcut handler. Called from the bubble-phase `key-pressed` of
    // the window-spanning FocusScope in main.slint, so it only sees keys the
    // focused widget (text input, list, slider, ...) rejected.
    public function global-key-pressed(event: KeyEvent) -> EventResult {
        if event.modifiers.control && event.modifiers.shift && (event.text == "i" || event.text == "I") {
            show-inspector = !show-inspector;
            return accept;
        }
        // Escape closes the settings drawer. The playback settings side bar has its
        // own scope and never lets Escape get this far.
        if event.text == Key.Escape && show-settings {
            show-settings = false;
            return accept;
        }
        // Reaching here means no widget took the tab, so focus is about to move.
        // Rejecting keeps that traversal; the bump is only a notification.
        if event.text == Key.Tab || event.text == Key.Backtab {
            tab-nav-serial += 1;
            return reject;
        }
        // Reaching here means no widget took the tab, so focus is about to move.
        // Rejecting keeps that traversal; the bump is only a notification.
        if event.text == Key.Tab || event.text == Key.Backtab {
            tab-nav-serial += 1;
            return reject;
        }
        if event.text == "q" {
            force-quit();
            return accept;
        } else if event.text == "d" {
            toggle-debug-mode();
            return accept;
        } else if event.text == "f" {
            toggle-fullscreen();
            return accept;
        } else if Bridge.is-playing() && event.text == Key.Space {
            resume-or-pause();
            return accept;
        } else if Bridge.is-playing() && event.text == Key.LeftArrow {
            Bridge.seek-to-percent((Bridge.progress-secs - 10) / Bridge.duration-secs);
        } else if Bridge.is-playing() && event.text == Key.RightArrow {
            Bridge.seek-to-percent((Bridge.progress-secs + 10) / Bridge.duration-secs);
        } else if Bridge.is-playing() && event.text == Key.DownArrow {
            Bridge.set-volume(Math.clamp(Bridge.volume - 0.05, 0.0, 1.0));
        } else if Bridge.is-playing() && event.text == Key.UpArrow {
            Bridge.set-volume(Math.clamp(Bridge.volume + 0.05, 0.0, 1.0));
        }

        reject
    }
}

export global Assets {
    out property <image> background-dark: @image-url("../../../ui-components/icons/background-img-dark.png");
    out property <image> exclamation-mark: @image-url("../../../ui-components/icons/exclamation-mark.png");
}
