--- a/subprojects/gstreamer/gst/gstvalue.c
+++ b/subprojects/gstreamer/gst/gstvalue.c
@@ -157,6 +157,12 @@ struct _GstValueList
   guint len;
 
   guint allocated;
+  /* Lists are shared on copy and only materialized when mutated
+   * (copy-on-write): a term in the refcount is a GValue holding this
+   * list. Mutating entries through a peeked/borrowed pointer was
+   * always undefined and now corrupts every sharer. Atomic, since
+   * sharing values may be copied and freed from different threads. */
+  gint refcount;
   GValue arr[1];
 };
 
@@ -280,10 +286,55 @@ _gst_value_list_new (guint prealloc)
   res->len = 0;
   res->allocated = n_alloc;
   res->fields = &res->arr[0];
+  res->refcount = 1;
 
   return res;
 }
 
+static inline GstValueList *
+gst_value_list_ref (GstValueList * vlist)
+{
+  g_atomic_int_inc (&vlist->refcount);
+  return vlist;
+}
+
+static void
+gst_value_list_unref (GstValueList * vlist)
+{
+  if (g_atomic_int_dec_and_test (&vlist->refcount)) {
+    guint i;
+
+    for (i = 0; i < vlist->len; i++)
+      g_value_unset (&vlist->fields[i]);
+    if (VALUE_LIST_IS_USING_DYNAMIC_ARRAY (vlist))
+      g_free (vlist->fields);
+    g_free (vlist);
+  }
+}
+
+static GstValueList *copy_gst_value_list (const GstValueList * src);
+
+/* Get the list payload of @value for mutation, materializing a private
+ * copy first when it is shared. NOCOPY values borrow a caller-owned
+ * list and are passed through, matching the previous in-place
+ * mutation behavior for them. */
+static GstValueList *
+gst_value_list_ensure_writable (GValue * value)
+{
+  GstValueList *vlist = VALUE_LIST_ARRAY (value);
+
+  if ((value->data[1].v_uint & G_VALUE_NOCOPY_CONTENTS) == 0 &&
+      G_UNLIKELY (g_atomic_int_get (&vlist->refcount) != 1)) {
+    GstValueList *copy = copy_gst_value_list (vlist);
+
+    gst_value_list_unref (vlist);
+    value->data[0].v_pointer = copy;
+    vlist = copy;
+  }
+
+  return vlist;
+}
+
