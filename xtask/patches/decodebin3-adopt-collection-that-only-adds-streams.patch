@@ -2710,6 +2710,29 @@ collections_are_identical (GstStreamCollection * collection,
   return TRUE;
 }
 
+/* Whether @collection contains every stream of @previous, i.e. it only ever
+ * ADDS streams. Unlike DecodebinCollection.is_update, which records how a
+ * collection related to the input collection preceding it, this answers the
+ * question against an arbitrary other collection. */
+static gboolean
+collection_extends (GstStreamCollection * collection,
+    GstStreamCollection * previous)
+{
+  guint i, len = gst_stream_collection_get_size (previous);
+
+  if (gst_stream_collection_get_size (collection) < len)
+    return FALSE;
+
+  for (i = 0; i < len; i++) {
+    GstStream *stream = gst_stream_collection_get_stream (previous, i);
+    const gchar *sid = gst_stream_get_stream_id (stream);
+    if (!stream_in_collection (collection, (gchar *) sid))
+      return FALSE;
+  }
+
+  return TRUE;
+}
+
 /** handle_stream_collection_locked:
  * @dbin:
  * @collection: (transfer none): The new collection for @input. Can be %NULL.
@@ -3438,8 +3461,21 @@ mq_slot_handle_stream_start (MultiQueueSlot * slot, GstEvent * stream_event)
     goto check_for_switch;
   }
 
-  /* If the new collection is fully present, we can switch */
-  if (collection->all_streams_present) {
+  /* If the new collection is fully present, we can switch.
+   *
+   * A collection that merely ADDS streams to the one currently being output can
+   * be adopted straight away as well: every stream already flowing is still in
+   * it, so nothing is orphaned, and the added streams pick up their slots as
+   * they arrive. Requiring all_streams_present for that case deadlocks whenever
+   * some stream in the collection never gets a multiqueue slot at all - an
+   * empty or immediately-EOS stream, for instance. The collection can then
+   * never be adopted, so its requested selection is never the one
+   * stream_is_requested() consults, and the streams that WERE added are refused
+   * an output forever ("Not selected, not creating any output") even though
+   * update_requested_selection() already chose them. */
+  if (collection->all_streams_present
+      || collection_extends (collection->collection,
+          dbin->output_collection->collection)) {
     GST_DEBUG_OBJECT (dbin, "Switching to new output collection");
     dbin->collections =
         g_list_remove (dbin->collections, dbin->output_collection);
