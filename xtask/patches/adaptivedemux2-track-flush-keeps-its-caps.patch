@@ -534,6 +534,44 @@
   store->events_pending = FALSE;
 }
 
+/* Drop only the sticky events a flush invalidates, i.e. the ones a GstPad
+ * itself drops on FLUSH_STOP (see gst_pad_send_event_unchecked()), and keep
+ * the rest.
+ *
+ * CAPS is the one that matters. Upstream will NOT send its caps again just
+ * because this side forgot it: its own sticky event has not changed and its
+ * peer pad has not changed either, so nothing makes it re-push. A store that
+ * has been fully flushed therefore has no caps left to hand to the next output
+ * slot, and the track goes out with a segment and buffers and no caps at all -
+ * which downstream cannot build anything from. */
+void
+gst_event_store_flush_invalidated (GstEventStore * store)
+{
+  guint i;
+  GArray *events = store->events;
+  gboolean events_pending = FALSE;
+
+  for (i = 0; i < events->len;) {
+    PadEvent *ev = &g_array_index (events, PadEvent, i);
+    GstEventType type =
+        ev->event ? GST_EVENT_TYPE (ev->event) : GST_EVENT_UNKNOWN;
+
+    if (ev->event == NULL || type == GST_EVENT_EOS
+        || type == GST_EVENT_SEGMENT || type == GST_EVENT_STREAM_GROUP_DONE) {
+      if (ev->event)
+        gst_event_unref (ev->event);
+      g_array_remove_index (events, i);
+      continue;
+    }
+
+    if (!ev->delivered)
+      events_pending = TRUE;
+    i++;
+  }
+
+  store->events_pending = events_pending;
+}
+
