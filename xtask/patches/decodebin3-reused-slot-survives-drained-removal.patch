@@ -1400,9 +1410,43 @@
  *
  * Must be called with the SELECTION_LOCK taken.
  */
+static gboolean stream_is_requested (GstDecodebin3 * dbin,
+    const gchar * stream_id);
+
 static void
 remove_slot_from_streaming_thread (GstDecodebin3 * dbin, MultiQueueSlot * slot)
 {
+  /* A drained slot is not necessarily a DEAD slot. Three live shapes reach
+   * here and each used to lose the stream:
+   *
+   *  - The slot was re-assigned to a successor input's stream (a gapless
+   *    input switch) while the drained flag was still set by the EOS sent
+   *    during its momentarily-unused window; the successor's STREAM_START
+   *    that clears the flag can still be queued behind that EOS.
+   *  - The slot's stream is still REQUESTED: a fast-decoding stream fully
+   *    drains its input seconds before downstream finishes playing it (deep
+   *    downstream queues), and removing the slot AND its output pad
+   *    mid-stream strands both this stream's tail and the successor a
+   *    gapless switch hands to the slot. The successor then races a fresh
+   *    slot whose output decision runs before the new collection is
+   *    current, is refused, and is never revisited.
+   *
+   * Removing the slot then frees its output pad and its queued data with
+   * nothing to recreate them. Only a slot nothing is assigned to and whose
+   * stream nobody requests may be removed; pending_stream != active_stream
+   * is the same "promised onward" test handle_stream_switch uses. */
+  if (slot->input != NULL
+      || (slot->pending_stream && slot->pending_stream != slot->active_stream)
+      || (slot->active_stream_id
+          && stream_is_requested (dbin, slot->active_stream_id))) {
+    GST_DEBUG_OBJECT (slot->src_pad,
+        "Not removing live slot (input:%p pending_stream:%p requested:%d)",
+        slot->input, slot->pending_stream,
+        slot->active_stream_id
+        && stream_is_requested (dbin, slot->active_stream_id));
+    return;
+  }
+
   /* if slot is still there and already drained, remove it in here */
   if (slot->output) {
     DecodebinOutputStream *output = slot->output;
@@ -2159,6 +2203,26 @@
         s = gst_event_get_structure (event);
