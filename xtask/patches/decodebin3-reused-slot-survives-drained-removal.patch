+        /* A parsed input's downstream (the identity) used to be created
+         * lazily, at CAPS. A serialized event processed before then is
+         * forwarded into a sink pad with no internal target and consumed,
+         * lost for good. For THIS event that loss is fatal and silent: the
+         * slot never learns the stream, the collection's stream presence
+         * never completes, and the output collection never switches (the
+         * gapless input-switch wedge, reachable whenever this STREAM_START
+         * races the collection posting of a sibling pad). The event that
+         * declares the input parsed also decides the downstream is an
+         * identity, so create it here, before anything can be forwarded. */
+        if (!input->parsebin && !input->identity) {
+          /* setup_identity reads the input's GstStream off the ghost pad's
+           * sticky, and a sink pad stores the sticky only AFTER this event
+           * function returns. Store it now, or the eagerly-created input
+           * stream is born stream-less and link_to_slot on it is fatal
+           * ("could not get a multiqueue slot"). */
+          gst_pad_store_sticky_event (input->ghost_sink, event);
+          gst_decodebin_input_setup_identity (input);
+        }
       }
 
