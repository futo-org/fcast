+/* A switch from current_variant is only playable when codecs (and so the
+ * container) match: the segment parser and decode chain are built from the
+ * first segment and never rebuilt. Compared by caps structure names in both
+ * directions. Variants without codec info stay allowed. */
+static gboolean
+variant_is_codec_compatible (GstHLSVariantStream * candidate,
+    GstHLSVariantStream * current)
+{
+  guint i, j;
+
+  if (current == NULL || candidate == current)
+    return TRUE;
+  if (current->caps == NULL || candidate->caps == NULL)
+    return TRUE;
+
+  for (i = 0; i < gst_caps_get_size (current->caps); i++) {
+    const gchar *name =
+        gst_structure_get_name (gst_caps_get_structure (current->caps, i));
+    gboolean found = FALSE;
+
+    for (j = 0; j < gst_caps_get_size (candidate->caps); j++) {
+      if (gst_structure_has_name (gst_caps_get_structure (candidate->caps, j),
+              name)) {
+        found = TRUE;
+        break;
+      }
+    }
+    if (!found)
+      return FALSE;
+  }
+
+  for (i = 0; i < gst_caps_get_size (candidate->caps); i++) {
+    const gchar *name =
+        gst_structure_get_name (gst_caps_get_structure (candidate->caps, i));
+    gboolean found = FALSE;
+
+    for (j = 0; j < gst_caps_get_size (current->caps); j++) {
+      if (gst_structure_has_name (gst_caps_get_structure (current->caps, j),
+              name)) {
+        found = TRUE;
+        break;
+      }
+    }
+    if (!found)
+      return FALSE;
+  }
+
+  return TRUE;
+}
