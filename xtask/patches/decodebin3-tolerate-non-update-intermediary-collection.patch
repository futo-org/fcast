--- a/subprojects/gst-plugins-base/gst/playback/gstdecodebin3.c
+++ b/subprojects/gst-plugins-base/gst/playback/gstdecodebin3.c
@@ -3457,10 +3457,18 @@
         "Dropping intermediary collection %p is_update:%d %" GST_PTR_FORMAT,
         candidate, candidate->is_update, candidate->collection);
 
-    /* Dropping an intermediate collection is only possible if there wasn't any
-     * previous output collection or it was an update of the previous one
-     */
-    g_assert (candidate->is_update || dbin->output_collection == NULL);
+    /* Dropping an intermediate collection should only happen if there wasn't
+     * any previous output collection or it was an update of the previous one.
+     * But a non-update collection can also linger here: a collection which
+     * removed or replaced deselected streams never sees any of its streams
+     * reach the multiqueue (their inputs get unlinked or die before pushing
+     * anything), so it never becomes the output collection. Jumping over it
+     * to the newer collection is the correct outcome in that case. */
+    if (!candidate->is_update && dbin->output_collection != NULL) {
+      GST_WARNING_OBJECT (dbin,
+          "Dropping non-update intermediary collection %" GST_PTR_FORMAT
+          " while an output collection is present", candidate->collection);
+    }
     dbin->collections = g_list_remove (dbin->collections, candidate);
     db_collection_free (candidate);
   }
