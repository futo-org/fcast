@@ -542,15 +545,73 @@ gst_multiqueue_pad_finalize (GObject * object)
   G_OBJECT_CLASS (gst_multiqueue_pad_parent_class)->finalize (object);
 }
 
+/* GstPadClass::forward implementation: a multiqueue pad has exactly one
+ * internal link, the other pad of its GstSingleQueue, so call the forward
+ * function directly on it instead of going through the generic GstIterator
+ * machinery. The internal pad is resolved exactly like
+ * gst_multi_queue_iterate_internal_links() resolves it, and the no-parent
+ * bail-out matches ACQUIRE_PARENT in gst_pad_iterate_internal_links(); the
+ * parent is only checked, never dereferenced, so no reference is taken. */
+static gboolean
+gst_multiqueue_pad_forward (GstPad * pad, GstPadForwardFunction forward,
+    gpointer user_data)
+{
+  GstSingleQueue *sq;
+  GstPad *opad;
+  gboolean res = FALSE;
+
+  GST_OBJECT_LOCK (pad);
+  if (G_UNLIKELY (GST_PAD_ITERINTLINKFUNC (pad) !=
+          gst_multi_queue_iterate_internal_links)) {
+    /* a custom internal-links function was installed on this pad instance,
+     * use the generic iterator-based implementation */
+    GST_OBJECT_UNLOCK (pad);
+    return GST_PAD_CLASS (gst_multiqueue_pad_parent_class)->forward (pad,
+        forward, user_data);
+  }
+  if (G_UNLIKELY (GST_OBJECT_PARENT (pad) == NULL
+          && GST_PAD_NEEDS_PARENT (pad))) {
+    GST_OBJECT_UNLOCK (pad);
+    GST_DEBUG_OBJECT (pad, "no parent");
+    return FALSE;
+  }
+  GST_OBJECT_UNLOCK (pad);
+
+  sq = GST_MULTIQUEUE_PAD (pad)->sq;
+
+  switch (GST_PAD_DIRECTION (pad)) {
+    case GST_PAD_SRC:
+      opad = g_weak_ref_get (&sq->sinkpad);
+      break;
+    case GST_PAD_SINK:
+      opad = g_weak_ref_get (&sq->srcpad);
+      break;
+    default:
+      g_return_val_if_reached (FALSE);
+  }
+
+  if (opad) {
+    GST_LOG_OBJECT (pad, "calling forward function on pad %s:%s",
+        GST_DEBUG_PAD_NAME (opad));
+    res = forward (opad, user_data);
+    gst_object_unref (opad);
+  }
+
+  return res;
+}
+
