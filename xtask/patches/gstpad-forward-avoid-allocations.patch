+/* We keep the already-forwarded pads in a stack array of this size and only
+ * fall back to a heap allocation if more are needed, which should usually never
+ * happen. */
+#define N_STACK_ALLOCATE_FORWARDED_PADS (16)
+
+/* Above this many already-forwarded pads, the linear membership scan used
+ * during a resync would become O(n^2), so switch to a hash table. */
+#define N_HASH_DEDUP_THRESHOLD (64)
+
+/* Set of pads already handed to the forward function, so that after a resync
+ * (the internal pad set changed mid-iteration) @forward is not called twice for
+ * the same pad. The pad pointers are only ever compared, never dereferenced.
+ *
+ * The common case forwards to a handful of pads and never resyncs, so it only
+ * ever appends and never looks up: a small stack array (no allocation) is
+ * enough. Membership is only ever queried after a resync, and a linear scan of
+ * a contiguous array beats a hash table until the set gets large, so a hash
+ * table is built lazily and only if we actually resync with many pads. */
+typedef struct
+{
+  GstPad *stack[N_STACK_ALLOCATE_FORWARDED_PADS];
+  GstPad **pads;
+  guint n;
+  guint size;
+  GHashTable *hash;             /* built lazily, see gst_pushed_pads_contains() */
+} GstPushedPads;
+
+static inline void
+gst_pushed_pads_init (GstPushedPads * p)
+{
+  p->pads = p->stack;
+  p->n = 0;
+  p->size = N_STACK_ALLOCATE_FORWARDED_PADS;
+  p->hash = NULL;
+}
+
+static inline void
+gst_pushed_pads_clear (GstPushedPads * p)
+{
+  if (p->hash) {
+    g_hash_table_destroy (p->hash);
+  }
+  if (p->pads != p->stack) {
+    g_free (p->pads);
+  }
+}
+
+static inline void
+gst_pushed_pads_add (GstPushedPads * p, GstPad * pad)
+{
+  if (p->hash) {
+    g_hash_table_add (p->hash, pad);
+    return;
+  }
+
+  /* reallocate on the heap if we needed more than
+   * N_STACK_ALLOCATE_FORWARDED_PADS pads */
+  if (G_UNLIKELY (p->n == p->size)) {
+    p->size *= 2;
+    if (p->pads == p->stack) {
+      p->pads = g_new (GstPad *, p->size);
+      memcpy (p->pads, p->stack, sizeof (p->stack));
+    } else {
+      p->pads = g_renew (GstPad *, p->pads, p->size);
+    }
+  }
+  p->pads[p->n++] = pad;
+}
+
+/* Only called after a resync: on the common no-resync path membership is
+ * never queried and no hash table exists. */
+static gboolean
+gst_pushed_pads_contains (GstPushedPads * p, GstPad * pad)
+{
+  guint i;
+
+  /* Only create a hash table once a resync has actually happened (we are only
+   * called then) and the set is large enough that the linear scan below would
+   * dominate. Keeps membership O(1) for the rest of this (already
+   * exceptional) forward. */
+  if (!p->hash && p->n > N_HASH_DEDUP_THRESHOLD) {
+    p->hash = g_hash_table_new (NULL, NULL);
+    for (i = 0; i < p->n; i++) {
+      g_hash_table_add (p->hash, p->pads[i]);
+    }
+  }
+
+  if (p->hash) {
+    return g_hash_table_contains (p->hash, pad);
+  }
+
+  for (i = 0; i < p->n; i++) {
+    if (p->pads[i] == pad) {
+      return TRUE;
+    }
+  }
+  return FALSE;
+}
+
+/* Fast path of gst_pad_forward() for pads using the default internal-links
+ * function: walk the parent element's opposite-direction pad list directly
+ * instead of allocating a GstIterator. This takes the same object lock and
+ * checks the same pads_cookie the iterator would use, so the iteration and
+ * resync semantics are identical. */
+static gboolean
+gst_pad_forward_default_links (GstPad * pad, GstElement * eparent,
+    GstPadForwardFunction forward, gpointer user_data)
+{
+  gboolean result = FALSE;
+  GstPushedPads pushed;
+  gboolean resynced = FALSE;
+  GList **padlist;
+  guint32 cookie;
+  GList *l;
+
+  gst_pushed_pads_init (&pushed);
+
+  if (pad->direction == GST_PAD_SRC) {
+    padlist = &eparent->sinkpads;
+  } else {
+    padlist = &eparent->srcpads;
+  }
+
+  GST_OBJECT_LOCK (eparent);
+
+restart:
+  cookie = eparent->pads_cookie;
+
+  for (l = *padlist; l != NULL; l = l->next) {
+    GstPad *intpad = GST_PAD_CAST (l->data);
+
+    /* if we have restarted, check if we have already pushed */
+    if (resynced && gst_pushed_pads_contains (&pushed, intpad)) {
+      continue;
+    }
+
+    /* the list holds a ref, but the pad must stay alive while we drop the
+     * lock to call the forward function */
+    gst_object_ref (intpad);
+    GST_OBJECT_UNLOCK (eparent);
+
+    GST_LOG_OBJECT (pad, "calling forward function on pad %s:%s",
+        GST_DEBUG_PAD_NAME (intpad));
+    result = forward (intpad, user_data);
+
+    /* record and drop our ref before re-taking the element lock: if the
+     * forward function removed the pad from the element this unref can be
+     * the last one, and dispose must not run under the element lock. The
+     * dedup set only compares the pointer, so adding it after the unref is
+     * fine. */
+    gst_pushed_pads_add (&pushed, intpad);
+    gst_object_unref (intpad);
+
+    GST_OBJECT_LOCK (eparent);
+
+    if (result) {
+      break;
+    }
+
+    /* the lock was released while calling the forward function, the pad
+     * list might have changed */
+    if (G_UNLIKELY (cookie != eparent->pads_cookie)) {
+      resynced = TRUE;
+      goto restart;
+    }
+  }
+
+  GST_OBJECT_UNLOCK (eparent);
+
+  gst_pushed_pads_clear (&pushed);
+
+  return result;
+}
