+/* GstPadClass::forward implementation for proxy/ghost pads: they have exactly
+ * one internal pad, so call the forward function on it directly instead of
+ * going through the generic GstIterator machinery. The parent handling mirrors
+ * gst_pad_iterate_internal_links() and the internal pad is acquired exactly
+ * like gst_proxy_pad_iterate_internal_links_default() would, so the semantics
+ * are identical to the generic implementation. */
+static gboolean
+gst_proxy_pad_forward (GstPad * pad, GstPadForwardFunction forward,
+    gpointer user_data)
+{
+  gboolean result = FALSE;
+  GstObject *parent;
+  GstPad *internal;
+
+  GST_OBJECT_LOCK (pad);
+  if (G_UNLIKELY (GST_PAD_ITERINTLINKFUNC (pad) !=
+          gst_proxy_pad_iterate_internal_links_default)) {
+    /* a custom internal-links function was installed on this pad instance,
+     * use the generic iterator-based implementation */
+    GST_OBJECT_UNLOCK (pad);
+    return GST_PAD_CLASS (gst_proxy_pad_parent_class)->forward (pad, forward,
+        user_data);
+  }
+  if (G_LIKELY ((parent = GST_OBJECT_PARENT (pad))))
+    gst_object_ref (parent);
+  else if (G_LIKELY (GST_PAD_NEEDS_PARENT (pad)))
+    goto no_parent;
+  GST_OBJECT_UNLOCK (pad);
+
+  internal = GST_PAD_CAST (gst_proxy_pad_get_internal (GST_PROXY_PAD_CAST
+          (pad)));
+
+  if (parent)
+    gst_object_unref (parent);
+
+  if (internal) {
+    GST_LOG_OBJECT (pad, "calling forward function on pad %s:%s",
+        GST_DEBUG_PAD_NAME (internal));
+    result = forward (internal, user_data);
+    gst_object_unref (internal);
+  }
+
+  return result;
+
+  /* ERRORS */
+no_parent:
+  {
+    GST_DEBUG_OBJECT (pad, "no parent");
+    GST_OBJECT_UNLOCK (pad);
+    return FALSE;
+  }
+}
+
 static void
 gst_proxy_pad_class_init (GstProxyPadClass * klass)
 {
+  GstPadClass *pad_class = GST_PAD_CLASS (klass);
+
+  pad_class->forward = gst_proxy_pad_forward;
+
   /* Register common function pointer descriptions */
   GST_DEBUG_REGISTER_FUNCPTR (gst_proxy_pad_iterate_internal_links_default);
   GST_DEBUG_REGISTER_FUNCPTR (gst_proxy_pad_chain_default);
