+/* Fast path for same-type scalar entries in list intersections, for
+ * which equality is the entire intersection (no same-type intersect
+ * function exists for these types). Skips the per-entry type checks,
+ * compare-function lookup and dispatch of gst_value_intersect().
+ *
+ * Returns TRUE when the pair was handled, storing the verdict in @hit
+ * and, on a hit, the intersection (a copy of @item) in @dest when
+ * non-NULL. @dest must be zero-initialized. Returns FALSE when the
+ * pair needs the generic gst_value_intersect() path.
+ */
+static inline gboolean
+gst_value_intersect_scalar_fast (GValue * dest, const GValue * item,
+    const GValue * value2, GType type2, gboolean * hit)
+{
+  gboolean equal;
+
+  if (G_VALUE_TYPE (item) != type2)
+    return FALSE;
+
+  if (type2 == G_TYPE_STRING) {
+    const gchar *s1 = item->data[0].v_pointer;
+    const gchar *s2 = value2->data[0].v_pointer;
+
+    /* Mirrors gst_value_compare_string: both NULL compare equal, a
+     * single NULL is unordered (no intersection). */
+    equal = (s1 == s2) || (s1 != NULL && s2 != NULL && strcmp (s1, s2) == 0);
+  } else if (type2 == G_TYPE_INT) {
+    equal = item->data[0].v_int == value2->data[0].v_int;
+  } else {
+    return FALSE;
+  }
+
+  *hit = equal;
+  if (equal && dest != NULL)
+    gst_value_init_and_copy (dest, item);
+  return TRUE;
+}
+
