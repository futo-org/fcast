--- a/subprojects/gst-plugins-base/gst/playback/gstdecodebin3.c
+++ b/subprojects/gst-plugins-base/gst/playback/gstdecodebin3.c
@@ -4478,6 +4478,24 @@
   if (collection == dbin->output_collection)
     handle_stream_switch (dbin);
 
+  /* A selection that requires no actual switch (every requested stream is
+   * already active) schedules no reconfiguration, so the streaming-thread
+   * paths that normally post STREAMS_SELECTED never run for it. The
+   * application still needs the answer to its event (carrying this event's
+   * seqnum) or it cannot tell that the request settled, and a request
+   * tracked as forever in flight blocks any follow-up selection. Post it
+   * here in that case. When a real switch was scheduled this returns NULL
+   * (streams still activating) and the reconfiguration posts as usual. */
+  {
+    GstMessage *selection_msg = is_selection_done (dbin);
+    if (selection_msg) {
+      SELECTION_UNLOCK (dbin);
+      gst_element_post_message ((GstElement *) dbin, selection_msg);
+      gst_event_unref (event);
+      return TRUE;
+    }
+  }
+
 beach:
   SELECTION_UNLOCK (dbin);
   gst_event_unref (event);
