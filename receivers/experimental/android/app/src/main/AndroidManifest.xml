<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <!-- The multicast lock mDNS needs with the screen off. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Start on boot, opt-in: the receiver below is disabled until the
         user turns the setting on. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Launch the player when a cast arrives while backgrounded, the
         Kotlin receiver precedent. User-granted, checked at runtime. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>

    <!-- The wifi permissions above imply required wifi hardware on Play and
         touchscreen is required by default; both would filter set-top and TV
         devices, the natural hosts for a cast target. -->
    <!-- The overlay prompt checks the settings page exists first. -->
    <queries>
        <intent>
            <action android:name="android.settings.action.MANAGE_OVERLAY_PERMISSION" />
        </intent>
    </queries>

    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="false"
        android:banner="@mipmap/ic_banner"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.FCastReceiver">

        <!-- Release builds stay profileable from the shell (simpleperf,
             Studio profiler) on Android 10+; ignored below that. -->
        <profileable android:shell="true" tools:targetApi="29" />

        <!-- Opaque launch trampoline (SplashActivity): its starting window
             brands the cold start that the translucent NativeActivity below
             cannot. Same task as MainActivity so it sits behind it during the
             draw gap. Declared under the Kotlin receiver's launcher component
             name so pinned icons, TV favorites and autostart apps survive the
             update from it. No excludeFromRecents: as the task's root it
             marks the whole task, which recents then trims (finishing the
             receiver) as soon as another task opens behind Home. -->
        <activity
            android:name="com.futo.fcast.receiver.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FCastReceiver">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The slint input view reports itself a text editor, and on TV the
             window-focus path auto-shows the IME at launch. Explicit
             show_keyboard() is unaffected. Launched by SplashActivity and by
             the cast bring-to-front, both explicit intents, so no launcher
             filter of its own. -->
        <activity
            android:name=".MainActivity"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|uiMode|orientation|screenSize|smallestScreenSize|layoutDirection|density|fontScale|colorMode|fontWeightAdjustment|grammaticalGender"
            android:resizeableActivity="true"
            android:exported="true">
            <meta-data
                android:name="android.app.lib_name"
                android:value="fcastreceiver" />
        </activity>

        <!-- specialUse while idle-discoverable, promoted to mediaPlayback
             while casting: a mediaPlayback FGS with nothing playing is a
             Play policy flag, and the honest split is what the platform
             asks for. -->
        <!-- Enabled only while start on boot is on (ReceiverCore.syncBootComponent),
             so with the setting off nothing runs at boot. An update ends the
             process too, hence MY_PACKAGE_REPLACED. Enabled until the first
             start sets it: an upgrade from the Kotlin receiver, which came up
             at boot, has to start before anyone opens the app. A fresh install
             gets no broadcasts until its first launch. -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".ReceiverService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Network cast receiver staying reachable for local-network senders while backgrounded" />
        </service>
    </application>

</manifest>
