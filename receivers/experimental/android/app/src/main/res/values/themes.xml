<resources>
    <!-- The starting window inherits windowBackground; the app's own
         background art makes splash and first frame indistinguishable. -->
    <style name="Theme.FCastReceiver" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:statusBarColor">#0E0F10</item>
        <item name="android:navigationBarColor">#0E0F10</item>
    </style>
</resources>
