<?xml version="1.0" encoding="utf-8"?>
<!-- Starting-window content: the system shows this before onCreate runs, so
     it brands the cold-start gap on the translucent NativeActivity where the
     API 31 SplashScreen does not render. Gradient fill plus the centered
     mark. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:src="@drawable/splash_background"
            android:gravity="fill" />
    </item>
    <item>
        <bitmap
            android:src="@drawable/ic_splash_logo"
            android:gravity="center" />
    </item>
</layer-list>
