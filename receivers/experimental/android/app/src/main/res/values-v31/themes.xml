<resources>
    <!-- Android 12+ shows the system SplashScreen regardless of
         windowDisablePreview, so give it the app colors instead of the
         default white flash. The base theme's disable-preview fix targets
         the Samsung starting-window animation on older releases. -->
    <style name="Theme.FCastReceiver" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="android:statusBarColor">#0E0F10</item>
        <item name="android:navigationBarColor">#0E0F10</item>
        <item name="android:windowSplashScreenBackground">#0E0F10</item>
    </style>
</resources>
