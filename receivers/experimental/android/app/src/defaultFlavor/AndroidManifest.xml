<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Self-update, the sideload build only: Play forbids the permission
         and updates the playstore flavor itself. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <receiver
            android:name="org.fcast.rsreceiver.android.UpdateStatusReceiver"
            android:exported="false" />

        <!-- Relaunches the receiver after an in-app update replaced it. -->
        <receiver
            android:name="org.fcast.rsreceiver.android.UpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
